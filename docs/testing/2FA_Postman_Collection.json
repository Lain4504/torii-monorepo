{
    "info": {
        "name": "Torii Nihongo - 2FA Testing",
        "description": "Complete 2FA flow testing collection",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080/api",
            "type": "string"
        },
        {
            "key": "accessToken",
            "value": "",
            "type": "string"
        },
        {
            "key": "tempToken",
            "value": "",
            "type": "string"
        },
        {
            "key": "totpSecret",
            "value": "",
            "type": "string"
        },
        {
            "key": "email",
            "value": "test@example.com",
            "type": "string"
        },
        {
            "key": "password",
            "value": "Test123456!",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Authentication",
            "item": [
                {
                    "name": "Login (No 2FA)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    if (response.accessToken) {",
                                    "        pm.collectionVariables.set('accessToken', response.accessToken);",
                                    "        console.log('✅ Access token saved');",
                                    "    }",
                                    "    if (response.requires2FA && response.tempToken) {",
                                    "        pm.collectionVariables.set('tempToken', response.tempToken);",
                                    "        console.log('⚠️ 2FA required - temp token saved');",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Register New User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    console.log('✅ User registered successfully');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"Test User\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. 2FA Setup",
            "item": [
                {
                    "name": "Get 2FA Status",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    console.log('2FA Status:', response);",
                                    "    if (response.isEnabled) {",
                                    "        console.log('✅ 2FA is enabled');",
                                    "        console.log('Method:', response.method);",
                                    "        console.log('Backup codes remaining:', response.backupCodesRemaining);",
                                    "    } else {",
                                    "        console.log('⚠️ 2FA is not enabled');",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/2fa/status",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "2fa",
                                "status"
                            ]
                        }
                    }
                },
                {
                    "name": "Generate TOTP Secret",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    pm.collectionVariables.set('totpSecret', response.secret);",
                                    "    console.log('✅ TOTP Secret generated:', response.secret);",
                                    "    console.log('📱 Manual Entry Key:', response.manualEntryKey);",
                                    "    console.log('🔗 QR Code URL (copy to browser):', response.qrCodeUrl.substring(0, 100) + '...');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/2fa/totp/generate",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "2fa",
                                "totp",
                                "generate"
                            ]
                        }
                    }
                },
                {
                    "name": "Enable TOTP 2FA",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    console.log('✅ 2FA enabled successfully!');",
                                    "    console.log('🔑 Backup Codes (SAVE THESE):');",
                                    "    response.backupCodes.forEach((code, index) => {",
                                    "        console.log(`  ${index + 1}. ${code}`);",
                                    "    });",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"secret\": \"{{totpSecret}}\",\n  \"code\": \"123456\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/2fa/totp/enable",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "2fa",
                                "totp",
                                "enable"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. 2FA Login Flow",
            "item": [
                {
                    "name": "Login (With 2FA) - Step 1",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    if (response.requires2FA) {",
                                    "        pm.collectionVariables.set('tempToken', response.tempToken);",
                                    "        console.log('⚠️ 2FA verification required');",
                                    "        console.log('Temp token saved:', response.tempToken.substring(0, 50) + '...');",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Verify 2FA Code - Step 2",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    pm.collectionVariables.set('accessToken', response.accessToken);",
                                    "    console.log('✅ 2FA verification successful!');",
                                    "    console.log('Access token saved');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"tempToken\": \"{{tempToken}}\",\n  \"code\": \"123456\",\n  \"backupCode\": false\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login/verify-2fa",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login",
                                "verify-2fa"
                            ]
                        }
                    }
                },
                {
                    "name": "Verify with Backup Code",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    pm.collectionVariables.set('accessToken', response.accessToken);",
                                    "    console.log('✅ Backup code verification successful!');",
                                    "    console.log('⚠️ This backup code is now used and cannot be reused');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"tempToken\": \"{{tempToken}}\",\n  \"code\": \"A1B2C3D4\",\n  \"backupCode\": true\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login/verify-2fa",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login",
                                "verify-2fa"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "4. Backup Codes",
            "item": [
                {
                    "name": "Regenerate Backup Codes",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    console.log('✅ Backup codes regenerated!');",
                                    "    console.log('🔑 New Backup Codes (SAVE THESE):');",
                                    "    response.backupCodes.forEach((code, index) => {",
                                    "        console.log(`  ${index + 1}. ${code}`);",
                                    "    });",
                                    "    console.log('⚠️ Old backup codes are no longer valid');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/2fa/backup-codes/regenerate",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "2fa",
                                "backup-codes",
                                "regenerate"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "5. Disable 2FA",
            "item": [
                {
                    "name": "Disable TOTP 2FA",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    console.log('✅ 2FA disabled successfully');",
                                    "    console.log('⚠️ Account is no longer protected by 2FA');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"password\": \"{{password}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/2fa/totp/disable",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "2fa",
                                "totp",
                                "disable"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "6. Error Cases",
            "item": [
                {
                    "name": "Enable with Wrong Code",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 400) {",
                                    "    console.log('✅ Correctly rejected invalid code');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"secret\": \"{{totpSecret}}\",\n  \"code\": \"000000\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/2fa/totp/enable",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "2fa",
                                "totp",
                                "enable"
                            ]
                        }
                    }
                },
                {
                    "name": "Disable with Wrong Password",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 400) {",
                                    "    console.log('✅ Correctly rejected invalid password');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"password\": \"WrongPassword123!\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/2fa/totp/disable",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "2fa",
                                "totp",
                                "disable"
                            ]
                        }
                    }
                },
                {
                    "name": "Access Without Token",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 401) {",
                                    "    console.log('✅ Correctly rejected unauthorized access');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/auth/2fa/status",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "2fa",
                                "status"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}