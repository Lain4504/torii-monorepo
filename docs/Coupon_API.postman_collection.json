{
  "info": {
    "name": "Coupon API",
    "description": "API Collection for Coupon Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8050",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "coupon_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "course_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "coupon_code",
      "value": "SUMMER2024",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Coupon CRUD",
      "item": [
        {
          "name": "Create Coupon (Percentage)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.coupon && response.data.coupon.id) {",
                  "        pm.collectionVariables.set('coupon_id', response.data.coupon.id);",
                  "        console.log('✅ Coupon ID saved:', response.data.coupon.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SUMMER2024\",\n  \"name\": \"Summer Sale 2024\",\n  \"description\": \"Giảm giá mùa hè cho tất cả khóa học\",\n  \"discountType\": \"percentage\",\n  \"discountValue\": 20,\n  \"maxDiscountAmount\": 500000,\n  \"minOrderAmount\": 100000,\n  \"applicableCourseIds\": [],\n  \"excludedCourseIds\": [],\n  \"validFrom\": \"2024-06-01T00:00:00Z\",\n  \"validUntil\": \"2024-08-31T23:59:59Z\",\n  \"usageLimit\": 100,\n  \"userUsageLimit\": 1,\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/coupons",
              "host": ["{{base_url}}"],
              "path": ["api", "coupons"]
            }
          },
          "response": []
        },
        {
          "name": "Create Coupon (Fixed Amount)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.coupon && response.data.coupon.id) {",
                  "        pm.collectionVariables.set('coupon_id', response.data.coupon.id);",
                  "        console.log('✅ Coupon ID saved:', response.data.coupon.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"FIXED50K\",\n  \"name\": \"Giảm 50K\",\n  \"description\": \"Giảm giá cố định 50,000 VND\",\n  \"discountType\": \"fixed_amount\",\n  \"discountValue\": 50000,\n  \"minOrderAmount\": 200000,\n  \"validFrom\": \"2024-01-01T00:00:00Z\",\n  \"validUntil\": \"2024-12-31T23:59:59Z\",\n  \"usageLimit\": null,\n  \"userUsageLimit\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/coupons",
              "host": ["{{base_url}}"],
              "path": ["api", "coupons"]
            }
          },
          "response": []
        },
        {
          "name": "Get All Coupons",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coupons?page=1&limit=10&status=active&search=",
              "host": ["{{base_url}}"],
              "path": ["api", "coupons"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "active"
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Coupon by ID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('coupon_id')) {",
                  "    console.warn('⚠️ Warning: coupon_id variable is empty. Please create a coupon first or set coupon_id manually.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/coupons/{{coupon_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "coupons", "{{coupon_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Coupon by Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/coupons/code/{{coupon_code}}",
              "host": ["{{base_url}}"],
              "path": ["api", "coupons", "code", "{{coupon_code}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Coupon",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('coupon_id')) {",
                  "    throw new Error('coupon_id is required. Please create a coupon first or set coupon_id manually.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Summer Sale 2024 - Updated\",\n  \"description\": \"Mô tả mới\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/coupons/{{coupon_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "coupons", "{{coupon_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Coupon",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('coupon_id')) {",
                  "    throw new Error('coupon_id is required. Please create a coupon first or set coupon_id manually.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coupons/{{coupon_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "coupons", "{{coupon_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Coupon Validation & Calculation",
      "item": [
        {
          "name": "Validate Coupon",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('course_id')) {",
                  "    console.warn('⚠️ Warning: course_id variable is empty. Please set course_id manually.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{coupon_code}}\",\n  \"courseId\": \"{{course_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/coupons/validate",
              "host": ["{{base_url}}"],
              "path": ["api", "coupons", "validate"]
            }
          },
          "response": []
        },
        {
          "name": "Calculate Discount",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('coupon_id')) {",
                  "    throw new Error('coupon_id is required. Please create a coupon first or set coupon_id manually.');",
                  "}",
                  "if (!pm.collectionVariables.get('course_id')) {",
                  "    console.warn('⚠️ Warning: course_id variable is empty. Please set course_id manually.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"couponId\": \"{{coupon_id}}\",\n  \"courseId\": \"{{course_id}}\",\n  \"basePrice\": 500000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/coupons/calculate-discount",
              "host": ["{{base_url}}"],
              "path": ["api", "coupons", "calculate-discount"]
            }
          },
          "response": []
        },
        {
          "name": "Get Available Coupons for Course",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('course_id')) {",
                  "    console.warn('⚠️ Warning: course_id variable is empty. Please set course_id manually.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/coupons/available/{{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "coupons", "available", "{{course_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Coupon Statistics",
      "item": [
        {
          "name": "Get Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coupons/statistics",
              "host": ["{{base_url}}"],
              "path": ["api", "coupons", "statistics"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
