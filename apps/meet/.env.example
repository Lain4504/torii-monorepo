# Meet Environment Variables
VITE_API_URL=http://localhost:8080
MEET_PORT=5180

# LiveKit Features
VITE_ENABLE_DYNACAST=true
VITE_ENABLE_SIMULCAST=true
VITE_VIDEO_CODEC=vp8
VITE_STOP_MIC_TRACK_ON_MUTE=true
VITE_FOCUS_ACTIVE_SPEAKER_WEBCAM=true
VITE_DISABLE_DARK_MODE=false

# Default Resolutions & Presets
VITE_DEFAULT_WEBCAM_RESOLUTION=h720
VITE_DEFAULT_SCREEN_SHARE_RESOLUTION=h1080fps15
VITE_DEFAULT_AUDIO_PRESET=music

# Assets & Customization
# Note: Complex types should be valid JSON strings
VITE_STATIC_ASSETS_PATH=
# VITE_CUSTOM_LOGO={"main_logo_light": "https://...", "main_logo_dark": "https://..."}
# VITE_DESIGN_CUSTOMIZATION={"primary_color": "#004D90", "secondary_color": "#24AEF7"}
# VITE_WHITEBOARD_PRELOADED_LIBRARY_ITEMS=["https://..."]
# VITE_VIRTUAL_BACKGROUND_IMAGES=["https://..."]

# ========================================
# Performance Configuration
# ========================================
# Adaptive Performance: automatically adjusts settings based on room size
# Set to 'false' to use static values below instead
VITE_ADAPTIVE_PERFORMANCE=true

# Static Performance Settings (used when VITE_ADAPTIVE_PERFORMANCE=false)
# Whiteboard throttle timings in milliseconds
VITE_WHITEBOARD_STROKE_THROTTLE=100
VITE_WHITEBOARD_APPSTATE_THROTTLE=150
VITE_WHITEBOARD_CURSOR_TIMEOUT=50

# Message Batching (reduces NATS publish calls)
VITE_ENABLE_MESSAGE_BATCHING=false
VITE_MESSAGE_BATCH_SIZE=3
VITE_MESSAGE_BATCH_TIMEOUT=50

# Message Compression (reduces bandwidth usage)
VITE_ENABLE_COMPRESSION=false
VITE_COMPRESSION_THRESHOLD=5000

# NATS Performance
VITE_NATS_PUBLISH_TIMEOUT=3000
VITE_NATS_MAX_RECONNECT=5

