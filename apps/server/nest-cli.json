{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "modules/gateway/src",
  "monorepo": true,
  "root": ".",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": true,
    "tsConfigPath": "tsconfig.build.json",
    "plugins": [],
    "assets": []
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "modules/gateway",
      "entryFile": "main",
      "sourceRoot": "modules/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "modules/gateway/tsconfig.app.json",
        "webpack": false
      }
    },
    "identity": {
      "type": "application",
      "root": "services/identity",
      "entryFile": "main",
      "sourceRoot": "services/identity/src",
      "compilerOptions": {
        "tsConfigPath": "services/identity/tsconfig.app.json",
        "webpack": false
      }
    },
    "learning": {
      "type": "application",
      "root": "modules/learning",
      "entryFile": "main",
      "sourceRoot": "modules/learning/src",
      "compilerOptions": {
        "tsConfigPath": "modules/learning/tsconfig.app.json",
        "webpack": false
      }
    },
    "meet": {
      "type": "application",
      "root": "services/meet",
      "entryFile": "main",
      "sourceRoot": "services/meet/src",
      "compilerOptions": {
        "tsConfigPath": "services/meet/tsconfig.app.json",
        "webpack": false
      }
    },
    "agents": {
      "type": "application",
      "root": "services/agents",
      "entryFile": "main",
      "sourceRoot": "services/agents/src",
      "compilerOptions": {
        "tsConfigPath": "services/agents/tsconfig.app.json",
        "webpack": false,
        "assets": [
          {
            "include": "assets/**/*",
            "outDir": "dist/services/agents/src",
            "watchAssets": true
          }
        ]
      }
    },
    "gamification": {
      "type": "application",
      "root": "services/gamification",
      "entryFile": "main",
      "sourceRoot": "services/gamification/src",
      "compilerOptions": {
        "tsConfigPath": "services/gamification/tsconfig.app.json",
        "webpack": false
      }
    },
    "communication": {
      "type": "application",
      "root": "services/communication",
      "entryFile": "main",
      "sourceRoot": "services/communication/src",
      "compilerOptions": {
        "tsConfigPath": "services/communication/tsconfig.app.json",
        "webpack": false,
        "assets": [
          {
            "include": "**/*.pug",
            "outDir": "dist/services/communication/src",
            "watchAssets": true
          }
        ]
      }
    },
    "storage": {
      "type": "application",
      "root": "services/storage",
      "entryFile": "main",
      "sourceRoot": "services/storage/src",
      "compilerOptions": {
        "tsConfigPath": "services/storage/tsconfig.app.json",
        "webpack": false
      }
    },
    "billing": {
      "type": "application",
      "root": "services/billing",
      "entryFile": "main",
      "sourceRoot": "services/billing/src",
      "compilerOptions": {
        "tsConfigPath": "services/billing/tsconfig.app.json",
        "webpack": false
      }
    }
  }
}