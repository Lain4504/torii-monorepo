{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "modules/gateway/src",
  "monorepo": true,
  "root": ".",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "tsconfig.build.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "modules/gateway",
      "entryFile": "main",
      "sourceRoot": "modules/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "modules/gateway/tsconfig.app.json",
        "webpack": false
      }
    },
    "auth-service": {
      "type": "application",
      "root": "modules/auth-service",
      "entryFile": "main",
      "sourceRoot": "modules/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "modules/auth-service/tsconfig.app.json",
        "webpack": false
      }
    },
    "course-service": {
      "type": "application",
      "root": "modules/course-service",
      "entryFile": "main",
      "sourceRoot": "modules/course-service/src",
      "compilerOptions": {
        "tsConfigPath": "modules/course-service/tsconfig.app.json",
        "webpack": false
      }
    },
    "room-service": {
      "type": "application",
      "root": "modules/room-service",
      "entryFile": "main",
      "sourceRoot": "modules/room-service/src",
      "compilerOptions": {
        "tsConfigPath": "modules/room-service/tsconfig.app.json",
        "webpack": false
      }
    },
    "assessment-service": {
      "type": "application",
      "root": "modules/assessment-service",
      "entryFile": "main",
      "sourceRoot": "modules/assessment-service/src",
      "compilerOptions": {
        "tsConfigPath": "modules/assessment-service/tsconfig.app.json",
        "webpack": false
      }
    },
    "payment-service": {
      "type": "application",
      "root": "modules/payment-service",
      "entryFile": "main",
      "sourceRoot": "modules/payment-service/src",
      "compilerOptions": {
        "tsConfigPath": "modules/payment-service/tsconfig.app.json",
        "webpack": false
      }
    },
    "ai-service": {
      "type": "application",
      "root": "modules/ai-service",
      "entryFile": "main",
      "sourceRoot": "modules/ai-service/src",
      "compilerOptions": {
        "tsConfigPath": "modules/ai-service/tsconfig.app.json",
        "webpack": false
      }
    },
    "notification-service": {
      "type": "application",
      "root": "modules/notification-service",
      "entryFile": "main",
      "sourceRoot": "modules/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "modules/notification-service/tsconfig.app.json",
        "webpack": false
      }
    }
  }
}