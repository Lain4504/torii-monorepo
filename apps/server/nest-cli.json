{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "modules/gateway/src",
  "monorepo": true,
  "root": ".",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "tsconfig.build.json",
    "plugins": []
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "modules/gateway",
      "entryFile": "main",
      "sourceRoot": "modules/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "modules/gateway/tsconfig.app.json",
        "webpack": false
      }
    },
    "identity": {
      "type": "application",
      "root": "modules/identity",
      "entryFile": "main",
      "sourceRoot": "modules/identity/src",
      "compilerOptions": {
        "tsConfigPath": "modules/identity/tsconfig.app.json",
        "webpack": false
      }
    },
    "learning": {
      "type": "application",
      "root": "modules/learning",
      "entryFile": "main",
      "sourceRoot": "modules/learning/src",
      "compilerOptions": {
        "tsConfigPath": "modules/learning/tsconfig.app.json",
        "webpack": false
      }
    },
    "meet": {
      "type": "application",
      "root": "modules/meet",
      "entryFile": "main",
      "sourceRoot": "modules/meet/src",
      "compilerOptions": {
        "tsConfigPath": "modules/meet/tsconfig.app.json",
        "webpack": false
      }
    },
    "agents": {
      "type": "application",
      "root": "modules/agents",
      "entryFile": "main",
      "sourceRoot": "modules/agents/src",
      "compilerOptions": {
        "tsConfigPath": "modules/agents/tsconfig.app.json",
        "webpack": false
      }
    },
    "gamification": {
      "type": "application",
      "root": "modules/gamification",
      "entryFile": "main",
      "sourceRoot": "modules/gamification/src",
      "compilerOptions": {
        "tsConfigPath": "modules/gamification/tsconfig.app.json",
        "webpack": false
      }
    },
    "communication": {
      "type": "application",
      "root": "modules/communication",
      "entryFile": "main",
      "sourceRoot": "modules/communication/src",
      "compilerOptions": {
        "tsConfigPath": "modules/communication/tsconfig.app.json",
        "webpack": false
      }
    }
  }
}