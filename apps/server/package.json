{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "cd ../../packages/protocol && npm run build && cd ../../apps/server && npx prisma generate && nest build gateway && nest build auth-service && nest build course-service && nest build room-service",
    "format": "prettier --write \"modules/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "dev": "concurrently -c \"cyan.bold,magenta.bold,green.bold,yellow.bold\" \"npm:dev:gateway\" \"npm:dev:auth\" \"npm:dev:course\" \"npm:dev:room\"",
    "dev:gateway": "dotenv -e ../../.env -- nest start gateway --watch",
    "dev:auth": "dotenv -e ../../.env -- nest start auth-service --watch",
    "dev:course": "dotenv -e ../../.env -- nest start course-service --watch",
    "dev:room": "dotenv -e ../../.env -- nest start room-service --watch",
    "prod:gateway": "node dist/modules/gateway/apps/server/modules/gateway/src/main",
    "prod:auth": "node dist/modules/auth-service/apps/server/modules/auth-service/src/main",
    "prod:course": "node dist/modules/course-service/apps/server/modules/course-service/src/main",
    "prod:room": "node dist/modules/room-service/apps/server/modules/room-service/src/main",
    "lint": "eslint \"{modules,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@workspace/protocol": "workspace:*",
    "@bufbuild/protobuf": "^2.10.2",
    "@livekit/protocol": "^1.43.4",
    "@nats-io/jwt": "0.0.10-5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.1.9",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@supabase/supabase-js": "^2.87.1",
    "body-parser": "^2.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.3",
    "google-protobuf": "^3.21.4",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.15.0",
    "long": "^5.3.2",
    "nats": "^2.29.3",
    "pg": "^8.16.3",
    "protobufjs": "^7.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.2",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "9.0.8",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "grpc-tools": "^1.13.1",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^1.181.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/modules/"
    ],
    "moduleNameMapper": {
      "^@server/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^@server/proto(|/.*)$": "<rootDir>/libs/proto/src/$1",
      "^@prisma/generated$": "<rootDir>/generated/prisma/client",
      "^@prisma/generated/(.*)$": "<rootDir>/generated/prisma/$1",
      "(.+)\\.js$": "$1"
    }
  }
}