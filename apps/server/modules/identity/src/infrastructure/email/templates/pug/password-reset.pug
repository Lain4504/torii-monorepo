doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    title Đặt lại mật khẩu
  body(style="font-family: sans-serif; background-color: #f5f5f5; padding: 20px;")
    div(style="max-width: 600px; margin: 0 auto; background: white; padding: 20px; border-radius: 8px;")
      h2(style="color: #dc2626;") Xin chào #{displayName}!
      p Chúng tôi nhận được yêu cầu đặt lại mật khẩu của bạn.
      a(href=resetUrl, style="display: inline-block; background: #dc2626; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; margin: 10px 0;") Đặt lại mật khẩu
      p(style="color: gray; font-size: 0.9em;") Link hết hạn sau 1 giờ.
