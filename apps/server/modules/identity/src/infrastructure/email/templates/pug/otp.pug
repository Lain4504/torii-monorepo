doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    title #{title}
  body(style="font-family: sans-serif; background-color: #f5f5f5; padding: 20px;")
    div(style="max-width: 600px; margin: 0 auto; background: white; padding: 20px; border-radius: 8px; text-align: center;")
      h2(style="color: #2563eb;") Xin chào #{displayName || 'bạn'}!
      p #{message}
      div(style="background: #f3f4f6; padding: 20px; margin: 20px 0; border-radius: 8px; font-size: 32px; font-weight: bold; letter-spacing: 5px; color: #1e40af;") #{otp}
      p(style="color: gray; font-size: 0.9em;") Mã này sẽ hết hạn trong 10 phút.
      p(style="color: gray; font-size: 0.8em;") Nếu bạn không thực hiện yêu cầu này, vui lòng bỏ qua email này.
