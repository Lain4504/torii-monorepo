model ClassAttendance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  status     String   @db.VarChar(20) // PRESENT, ABSENT, LATE, EXCUSED
  recordedAt DateTime @default(now()) @map("recorded_at")

  session LiveScheduleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("academy_class_attendances")
}

model ClassReview {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId      String    @map("class_id") @db.Uuid
  enrollmentId String    @map("enrollment_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
