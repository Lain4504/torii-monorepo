// --- Room Artifacts ---

model RoomInfo {
  id                 Int    @id @default(autoincrement())
  roomTitle          String @default("") @map("room_title") @db.VarChar(255)
  roomId             String @map("room_id") @db.VarChar(64)
  sid                String @unique @map("sid") @db.VarChar(64)
  joinedParticipants Int    @default(0) @map("joined_participants")

  liveClassId String? @map("live_class_id") @db.Uuid
  classId     String? @map("class_id") @db.Uuid
  weekday     Int?
  startTime   String? @map("start_time") @db.VarChar(20)

  // Int, 1 for true 2 for false
  isRunning    Int    @default(0) @map("is_running")
  isRecording  Int    @default(0) @map("is_recording")
  recorderId   String @default("") @map("recorder_id") @db.VarChar(36)
  isActiveRtmp Int    @default(0) @map("is_active_rtmp")
  rtmpNodeId   String @default("") @map("rtmp_node_id") @db.VarChar(36)
  webhookUrl   String @default("") @map("webhook_url") @db.VarChar(255)

  isBreakoutRoom Int       @default(0) @map("is_breakout_room")
  parentRoomId   String    @default("") @map("parent_room_id") @db.VarChar(64)
  creationTime   Int       @default(0) @map("creation_time")
  created        DateTime  @default(now()) @map("created")
  ended          DateTime? @map("ended") // Nullable - null means not ended yet (PostgreSQL compatible)
  modified       DateTime  @default(now()) @updatedAt @map("modified")

  // Relations
  artifacts RoomArtifact[]

  @@index([roomId, isRunning], map: "idx_room_id")
  @@index([liveClassId])
  @@index([classId])
  @@map("room_info")
}

model RoomFile {
  id        Int      @id @default(autoincrement())
  fileId    String   @unique @map("file_id")
  roomId    String   @map("room_id")
  userId    String   @map("user_id")
  filePath  String   @map("file_path")
  fileType  String   @map("file_type")
  mimeType  String   @map("mime_type")
  fileSize  Float    @default(0) @map("file_size")
  createdAt DateTime @default(now()) @map("created")

  @@index([roomId])
  @@map("room_files")
}

model RoomArtifact {
  id          BigInt   @id @default(autoincrement())
  artifactId  String   @unique @map("artifact_id") @db.VarChar(64)
  roomTableId Int      @map("room_table_id")
  roomId      String   @map("room_id") @db.VarChar(255)
  type        String   @db.VarChar(100)
  metadata    Json?
  created     DateTime @default(now())

  // Relation to RoomInfo
  roomInfo RoomInfo @relation(fields: [roomTableId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([artifactId], map: "idx_artifact_artifact_id")
  @@index([roomId], map: "idx_artifact_room_id")
  @@index([type], map: "idx_artifact_type")
  @@map("room_artifacts")
}

// ==================================================
// 5. ASSESSMENT (LEGACY) — REMOVED
// ==================================================
// Quiz/Assignment/Question/Attempt mới sẽ nằm trong khối `ACADEMY CORE LMS (NEW)` (ở cuối file).

// ==================================================
// 6. FLASHCARD / SRS
// ==================================================

// --- Flashcards & Notes ---

model StudyNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @db.Text
  lessonId  String?  @map("lesson_id") @db.Uuid
  tags      String[] @default([]) @db.VarChar(50)
  metadata  Json?    @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  setCards SetCard[]

  @@index([userId])
  @@index([lessonId])
  @@map("academy_study_notes")
}

model StudySet {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  isPublic    Boolean  @default(false) @map("is_public")
  settings    Json?    @default("{}") @map("settings") @db.JsonB
  stats       Json?    @default("{\"cardCount\": 0, \"masteredCount\": 0}") @map("stats") @db.JsonB
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  setCards SetCard[]

  @@index([userId])
  @@map("academy_study_sets")
}

model SetCard {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studySetId       String   @map("study_set_id") @db.Uuid
  sourceNoteId     String?  @map("source_note_id") @db.Uuid
  term             String   @map("term") @db.Text
  definition       String   @map("definition") @db.Text
  hint             String?  @map("hint") @db.Text
  mediaUrl         String?  @map("media_url") @db.Text
  languageDetails  Json?    @map("language_details") @db.JsonB
  tags             String[] @default([]) @db.VarChar(50)
  
  sourceDocumentId String?  @map("source_document_id") @db.Uuid

  srsState     SrsState @default(LEARNING) @map("srs_state")
  nextReviewAt DateTime @default(now()) @map("next_review_at")
  interval     Int      @default(0) @map("interval")
  easeFactor   Decimal  @default(2.5) @map("ease_factor") @db.Decimal(4, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  studySet       StudySet   @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  sourceNote     StudyNote? @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  sourceDocument FileAsset? @relation("SetCardSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([studySetId])
  @@index([sourceNoteId])
  @@index([sourceDocumentId])
  @@index([srsState])
  @@map("academy_set_cards")
}



// ==================================================
// 7. USER & AUTH
// ==================================================

// --- Identity ---

model User {
  id          String @id @default(uuid()) @db.Uuid
  email       String @unique @db.VarChar(255)
  displayName String @map("display_name") @db.VarChar(100)

  // Auth fields
  password String? @db.VarChar(255) // Nullable for OAuth-only users

  // Profile fields
  avatarUrl String? @map("avatar_url") @db.Text

  // Metadata (JSON for flexibility)
  appMetadata  Json? @default("{}") @map("app_metadata") // App-specific data (providers, etc.)
  userMetadata Json? @default("{}") @map("user_metadata") // User profile data from OAuth

  // Role
  role String @default("learner") @db.VarChar(50)

  // Timestamps (replace status field - Supabase pattern)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamp() // null = not verified (pending)
  bannedUntil  DateTime? @map("banned_until") @db.Timestamp() // null = not banned, value = banned until this time
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamp()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp() // null = not deleted, value = soft deleted

  // Relations
  identities              UserIdentity[] // OAuth providers (email, google, etc.)
  sessions                Session[]
  twoFactorAuth           TwoFactorAuth?
  studySets               StudySet[]
  comments                Comment[]
  auditLogs               AuditLog[]               @relation("UserAuditLogs")
  orders                  Order[]
  tickets                 Ticket[]                 @relation("UserTickets")
  handledTickets          Ticket[]                 @relation("HandlerTickets")
  certificates            Certificate[]

  // Gamification Relations
  gamification    UserGamification?
  dailyActivities DailyActivity[]

  // Commerce (New)
  couponUsages CouponUsage[]

  commentLikes CommentLike[]

  // History Relations
  gamificationHistories        GamificationHistory[]
  studyNotes                   StudyNote[] // New Study Notes
  blogs                        Blog[]
  // Academy (new core LMS) relations
  academyEnrollments           Enrollment[]
  academyLearningProgresses    LearningProgress[]
  academyExamAttempts          ExamAttempt[]
  academyAssignmentSubmissions AssignmentSubmission[]
  academyClassesTaught         Class[]                @relation("AcademyClassTeacher")
  academyClassReviews          ClassReview[]
  userAchievements             UserAchievement[]
  academyClassAttendances      ClassAttendance[]
  liveScheduleRequests         LiveScheduleRequest[] @relation("LiveScheduleRequestRequester")
  reviewedLiveScheduleRequests LiveScheduleRequest[] @relation("LiveScheduleRequestReviewer")
  proposedTeacherScheduleRequests LiveScheduleRequest[] @relation("LiveScheduleRequestProposedTeacher")

  @@index([email])
  @@index([role])
  @@map("users")
}

model UserIdentity {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Provider info
  provider   String @db.VarChar(50) // 'email', 'google', etc.
  providerId String @map("provider_id") @db.VarChar(255) // Provider's user ID

  // Provider metadata
  providerData Json? @map("provider_data") // Raw data from provider

  // Timestamps
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamp()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId]) // Prevent duplicate provider accounts
  @@index([userId])
  @@index([provider])
  @@map("user_identities")
}

model Session {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64) // SHA-256 hash

  // Device & Metadata
  deviceInfo String? @map("device_info") @db.VarChar(100) // e.g., "iPhone 13, iOS 15" or "Chrome on Windows"

  expiresAt DateTime  @map("expires_at") @db.Timestamp()
  revokedAt DateTime? @map("revoked_at") @db.Timestamp()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model TwoFactorAuth {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // 2FA Status
  isEnabled Boolean @default(false) @map("is_enabled")
  method    String? @db.VarChar(20) // Currently only 'totp' supported (Google Authenticator)

  // TOTP Configuration (for Google Authenticator)
  totpSecret      String?  @map("totp_secret") @db.VarChar(255) // Encrypted with AES-256-GCM
  totpBackupCodes String[] @default([]) @map("totp_backup_codes") @db.VarChar(100) // Hashed with Argon2

  // Security & Metadata
  enabledAt      DateTime? @map("enabled_at") @db.Timestamp()
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamp()
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamp()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_auth")
}

// --- Permissions & Audit ---

model RolePermission {
  roleCode       String   @map("role_code") @db.VarChar(50)
  permissionCode String   @map("permission_code") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@id([roleCode, permissionCode])
  @@index([roleCode])
  @@map("role_permissions")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Who performed the action
  userId String @map("user_id") @db.Uuid

  // What action was performed
  action   String  @db.VarChar(100) // e.g., "permission.grant", "user.create", "course.delete"
  entity   String  @db.VarChar(100) // e.g., "role_permission", "user", "course"
  entityId String? @map("entity_id") @db.VarChar(255) // ID of affected entity

  // Action details
  description String @db.Text // Human-readable description
  metadata    Json? // Flexible JSON for action-specific data

  // State changes (for updates)
  oldValues Json? @map("old_values") // Previous state
  newValues Json? @map("new_values") // New state

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()

  // Relations
  user User @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// --- Orders & Payments ---

model Order {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String        @unique @db.VarChar(50) // ORD-20260306-XXXX
  userId        String        @map("user_id") @db.Uuid
  status        OrderStatus   @default(PENDING)
  subTotal      Decimal       @map("sub_total") @db.Decimal(12, 2)
  discountTotal Decimal       @map("discount_total") @db.Decimal(12, 2)
  grandTotal    Decimal       @map("grand_total") @db.Decimal(12, 2)
  currency      String        @default("VND") @db.VarChar(10)
  couponCode    String?       @map("coupon_code") @db.VarChar(50)
  couponId      String?       @map("coupon_id") @db.Uuid
  note          String?       @db.Text
  paymentMethod PaymentMethod @map("payment_method")
  metadata      Json?         @default("{}") @db.JsonB
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon       Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  transactions Transaction[]
  usages       CouponUsage[]
  enrollments  Enrollment[]
  tickets      Ticket[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("academy_orders")
}

model OrderItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  offeringId       String  @map("offering_id") @db.Uuid
  price            Decimal @db.Decimal(12, 2)
  offeringSnapshot Json    @map("offering_snapshot") @db.JsonB

  // Relations
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([offeringId])
  @@map("academy_order_items")
}

model Transaction {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  gateway         PaymentGateway
  transactionCode String?        @map("transaction_code") @db.VarChar(100)
  amount          Decimal        @db.Decimal(12, 2)
  status          String         @db.VarChar(20) // PENDING, SUCCESS, FAILED
  responsePayload Json?          @map("response_payload") @db.JsonB
  createdAt       DateTime       @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionCode])
  @@map("academy_transactions")
}

// --- Coupons & Wishlist ---

model Coupon {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String             @unique @db.VarChar(50)
  name              String?            @db.VarChar(200)
  description       String?            @db.Text
  discountType      CouponDiscountType @map("discount_type")
  discountValue     Decimal            @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?           @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderValue     Decimal?           @map("min_order_value") @db.Decimal(12, 2)
  usageLimit        Int?               @map("usage_limit")
  usageCount        Int                @default(0) @map("usage_count")
  perUserLimit      Int                @default(1) @map("per_user_limit")
  /// Scope of applicability: GLOBAL (anyone), SPECIFIC_OFFERING, PERSONAL (assigned to a single user), etc.
  startDate         DateTime?          @map("start_date")
  endDate           DateTime?          @map("end_date")
  status            CouponStatus       @default(ACTIVE)
  scope             CouponScope        @default(GLOBAL)
  /// Owner of the coupon when scope = PERSONAL (e.g. redeemed from gamification rewards)
  ownerId           String?            @map("owner_id") @db.Uuid
  /// Logical source for audit/analytics: MANUAL, CAMPAIGN, GAMIFICATION_REWARD, etc.
  source            String?            @db.VarChar(50)
  metadata          Json?              @default("{}") @db.JsonB
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")

  // Relations
  orders Order[]
  usages CouponUsage[]

  @@map("academy_coupons")
}

model CouponUsage {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId String   @map("coupon_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  orderId  String   @map("order_id") @db.Uuid
  usedAt   DateTime @default(now()) @map("used_at")

  // Relations
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade) // Added implicitly if needed

  @@index([couponId])
  @@index([userId])
  @@map("academy_coupon_usages")
}

// Wishlist (legacy course_run) removed; academy wishlist will be reintroduced against CourseOffering/Class later.

// ==================================================
// 9. GAMIFICATION
// ==================================================

// --- Gamification ---

model UserGamification {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // --- XP & Level System ---
  level     Int @default(1)
  currentXp Int @default(0) @map("current_xp") // XP hiện tại ở level này
  totalXp   Int @default(0) @map("total_xp") // Tổng XP tích lũy (dùng để đua Top)

  // --- Currency (Economy - Chuẩn bị sẵn cho tương lai) ---
  points Int @default(0) // Điểm thưởng dùng để đổi mã giảm giá
  gems   Int @default(0) // Đơn vị cao cấp (nếu có)

  // --- Streak System (Gộp từ UserStreak cũ vào đây) ---
  currentStreak  Int     @default(0) @map("current_streak")
  longestStreak  Int     @default(0) @map("longest_streak")
  lastActiveDate String? @map("last_active_date") @db.VarChar(10) // YYYY-MM-DD
  freezeCount    Int     @default(0) @map("freeze_count") // Số 'bùa' bảo vệ streak

  // --- Stats Aggregate (Lưu sẵn để đỡ phải count từ bảng khác) ---
  totalActiveDays    Int @default(0) @map("total_active_days")
  weeklyActiveCount  Int @default(0) @map("weekly_active_count")
  monthlyActiveCount Int @default(0) @map("monthly_active_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Index tối ưu
  @@index([totalXp(sort: Desc)]) // Index quan trọng nhất để lấy Leaderboard (Bảng xếp hạng)
  @@index([userId])
  @@map("user_gamification")
}

model Achievement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(64)
  category    String   @db.VarChar(32) // STREAK | CONSISTENCY | LEARNING_PROGRESS | ...
  title       String   @db.VarChar(255)
  description String?  @db.Text
  icon        String?  @db.VarChar(64)
  requirements Json    @default("{}") @db.JsonB
  rewards     Json     @default("{}") @db.JsonB
  isActive    Boolean  @default(true) @map("is_active")
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  achievementId String    @map("achievement_id") @db.Uuid
  isUnlocked    Boolean   @default(false) @map("is_unlocked")
  progress      Json?     @default("{}") @db.JsonB
  unlockedAt    DateTime? @map("unlocked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}



model DailyActivity {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  date         String       @db.VarChar(10) // YYYY-MM-DD
  activityType ActivityType @map("activity_type")
  count        Int          @default(1) // Số lần activity trong ngày (cho heatmap)

  // Metadata for analytics
  meta Json? @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, activityType])
  @@index([userId])
  @@index([date])
  @@index([activityType])
  @@map("daily_activities")
}



model PointReward {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @db.VarChar(100)
  description String? @db.Text
  costPoints  Int     @map("cost_points")
  type        String  @default("COUPON") @db.VarChar(50)
  config      Json    @default("{}") @db.JsonB
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("point_rewards")
}

// --- Finance Ledger ---



model GamificationHistory {
  id           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                      @map("user_id") @db.Uuid
  amount       Int // Số điểm biến động
  currency     GamificationCurrency        @default(POINT)
  type         GamificationTransactionType
  activityType ActivityType?               @map("activity_type")
  description  String?                     @db.Text
  metadata     Json?                       @default("{}") // Lưu trữ achievementId, v.v.
  createdAt    DateTime                    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([activityType])
  @@index([createdAt])
  @@map("gamification_histories")
}

// ==================================================
// 10. CONTENT & SOCIAL  (Blog / Discussion / Notification)
// ==================================================

// --- Files ---

model FileAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // File Identification
  fileUrl String @unique @map("file_url") @db.Text

  // File Details
  mimeType String? @map("mime_type") @db.VarChar(100)
  fileSize BigInt? @map("file_size")
  isPublic Boolean @default(false) @map("is_public")

  // Upload Status: 'pending' | 'uploaded' | 'failed'
  status String @default("pending") @db.VarChar(20)

  // Flexible Metadata (JSONB)
  metadata     Json?   @default("{}") @map("metadata")
  ownerId      String? @map("owner_id") @db.Uuid
  moduleOrigin String? @map("module_origin") @db.VarChar(50) // 'USER', 'COURSE', 'CHAT'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  setCardSourceDocs SetCard[] @relation("SetCardSourceDocument")

  @@index([ownerId])
  @@index([fileUrl])
  @@index([status])
  @@map("file_assets")
}

// --- Blog ---

model Blog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String    @db.VarChar(255)
  slug           String    @unique @db.VarChar(255)
  excerpt        String?   @db.Text
  content        String    @db.Text
  coverImageUrl  String?   @map("cover_image_url") @db.Text
  authorId       String    @map("author_id") @db.Uuid
  status         String    @default("draft") @db.VarChar(20) // draft, published, archived
  publishedAt    DateTime? @map("published_at")
  viewCount      Int       @default(0) @map("view_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([publishedAt(sort: Desc)])
  @@index([authorId])
  @@map("blogs")
}

// --- Discussion & Social ---

model Comment {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String  @map("user_id") @db.Uuid
  parentCommentId String? @map("parent_comment_id") @db.Uuid // For nested replies

  content   String   @db.Text
  status    String   @default("approved") @db.VarChar(20) // pending, approved, spam, deleted
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?        @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies Comment[]       @relation("CommentReplies")
  likes   CommentLike[]
  targets CommentTarget[]

  @@index([userId])
  @@index([parentCommentId])
  @@index([createdAt(sort: Desc)])
  @@map("comments")
}

model CommentTarget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commentId  String   @map("comment_id") @db.Uuid
  targetId   String   @map("target_id") @db.Uuid
  targetType String   @map("target_type") @db.VarChar(20) // BLOG, COURSE_RUN, etc.
  createdAt  DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, targetId, targetType])
  @@index([targetId, targetType])
  @@map("comment_targets")
}

model CommentLike {
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

// DiscussionTopic (legacy course_run) removed; will be redesigned for `academy` later.

// --- Notifications ---

model Notification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  title            String    @db.VarChar(255)
  message          String    @db.Text
  notificationType String?   @map("notification_type") @db.VarChar(50)
  metadata         Json?     @map("data")
  isRead           Boolean   @default(false) @map("is_read")
  readAt           DateTime? @map("read_at")
  sentVia          String[]  @default([]) @map("sent_via") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ==================================================
// 11. SUPPORT & MISC
// ==================================================

// --- Support ---

model Ticket {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  handlerId   String?      @map("handler_id") @db.Uuid
  type        TicketType   @default(SUPPORT)
  status      TicketStatus @default(PENDING)
  subject     String       @db.VarChar(255)
  description String       @db.Text
  classId     String?      @map("class_id") @db.Uuid
  orderId     String?      @map("order_id") @db.Uuid
  metadata    Json?        @default("{}") // Additional flexible metadata 

  response  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user    User   @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  handler User?  @relation("HandlerTickets", fields: [handlerId], references: [id], onDelete: SetNull)
  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([handlerId])
  @@index([status])
  @@index([type])
  @@index([classId])
  @@index([orderId])
  @@map("tickets")
}

model Certificate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  classId         String   @map("class_id") @db.Uuid
  enrollmentId    String   @unique @map("enrollment_id") @db.Uuid
  certificateCode String   @unique @map("certificate_code") @db.VarChar(50)
  issueDate       DateTime @default(now()) @map("issue_date")
  fileUrl         String   @map("file_url") @db.Text
  metadata        Json?    @default("{}")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([classId])
  @@map("certificates")
}

// --- Notes ---



// ==================================================
// 12. ACADEMY CORE LMS (NEW)
// ==================================================

// NOTE: Các model dưới đây là core schema mới cho service `academy`.
// Chúng không dùng lại CourseMaster/CourseRun cũ, mà tạo domain mới sạch hơn.

// --- Content layer ---

model CourseProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique @db.VarChar(100)
  title           String   @db.VarChar(255)
  description     String?  @db.Text
  level           String?  @db.VarChar(50)
  thumbnailUrl    String?  @map("thumbnail_url") @db.Text
  metadata        Json?    @default("{}") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  classes             Class[]
  lessons             Lesson[]
  exams               Exam[]
  questionPools       QuestionPool[]

  @@index([level])
  @@map("academy_course_profiles")
}

model Lesson {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId String   @map("course_profile_id") @db.Uuid
  title           String   @db.VarChar(255)
  contentType     String   @map("content_type") @db.VarChar(50) // VIDEO, HTML, MARKDOWN, EXTERNAL_LINK, ...
  contentUrl      String?  @map("content_url") @db.Text
  contentBody     String?  @map("content_body") @db.Text
  attachments     Json?    @default("[]") @db.JsonB
  metadata        Json?    @default("{}") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  courseProfile    CourseProfile      @relation(fields: [courseProfileId], references: [id], onDelete: Cascade)
  studyNotes       StudyNote[]

  @@index([courseProfileId])
  @@map("academy_lessons")
}


// --- Delivery layer ---

model Class {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId String      @map("course_profile_id") @db.Uuid
  code            String      @unique @db.VarChar(150)
  name            String      @db.VarChar(255)
  mode            ClassMode
  status          ClassStatus @default(DRAFT)
  settings        Json?       @default("{}") @db.JsonB
  
  defaultExpiresMonths Int?      @map("default_expires_months") // VOD
  openingDate          DateTime? @map("opening_date")           // LIVE
  closingDate          DateTime? @map("closing_date")           // LIVE
  instructorId         String?   @map("instructor_id") @db.Uuid // LIVE

  submittedForApprovalAt DateTime? @map("submitted_for_approval_at")
  submittedBy            String?   @map("submitted_by") @db.Uuid
  approvedAt            DateTime? @map("approved_at")
  approvedBy            String?   @map("approved_by") @db.Uuid
  rejectedAt            DateTime? @map("rejected_at")
  rejectedBy            String?   @map("rejected_by") @db.Uuid
  rejectionReason       String?   @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  courseProfile         CourseProfile          @relation(fields: [courseProfileId], references: [id], onDelete: Cascade)
  instructor            User?                  @relation("AcademyClassTeacher", fields: [instructorId], references: [id], onDelete: SetNull)
  modules               ClassModule[]
  enrollments           Enrollment[]
  learningProgress      LearningProgress[]
  examAttempts          ExamAttempt[]
  tickets               Ticket[]
  certificates          Certificate[]
  assignments           Assignment[]
  offeringLinks         CourseOfferingClass[]
  reviews               ClassReview[]
  liveSchedules         LiveSchedule[]
  liveScheduleSessions  LiveScheduleSession[]

  @@index([courseProfileId])
  @@index([mode])
  @@index([status])
  @@map("academy_classes")
}

model ClassModule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId    String   @map("class_id") @db.Uuid
  title      String   @db.VarChar(255)
  orderIndex Int      @map("order_index")

  // Relations
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  items ClassContentItem[]

  @@index([classId, orderIndex])
  @@map("academy_class_modules")
}

model ClassContentItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId       String   @map("module_id") @db.Uuid
  kind           String   @db.VarChar(20) // 'VIDEO' | 'MATERIAL' | 'EXAM' | 'ASSIGNMENT' | 'TOPIC'
  referenceId    String?  @map("reference_id") @db.Uuid
  orderIndex     Int      @map("order_index")
  status         String   @default("PUBLISHED") @db.VarChar(20)
  availableFrom  DateTime? @map("available_from")
  deadline       DateTime?
  isPrerequisite Boolean  @default(false) @map("is_prerequisite")
  settings       Json?    @default("{}") @db.JsonB

  // Relations
  module                ClassModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  learningProgresses    LearningProgress[]
  examAttempts          ExamAttempt[]

  @@index([moduleId, orderIndex])
  @@index([referenceId])
  @@map("academy_class_content_items")
}



model LiveSchedule {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId       String  @map("class_id") @db.Uuid
  weekday       Int // 0-6
  startTime     String  @map("start_time") @db.VarChar(20)
  endTime       String  @map("end_time") @db.VarChar(20)
  location      String? @db.VarChar(255)
  excludedDates Json?   @map("excluded_dates") @db.JsonB
  note          String? @db.Text
  roomId        String? @map("room_id") @db.VarChar(64)

  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessions LiveScheduleSession[]

  @@index([classId])
  @@map("academy_live_schedules")
}

/// Live session instance theo ngày cho từng buổi học cụ thể
model LiveScheduleSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  scheduleId String? @map("schedule_id") @db.Uuid

  /// Ngày diễn ra buổi học (theo timezone vận hành, lưu ở UTC)
  sessionDate DateTime @map("session_date")

  /// Giờ bắt đầu/kết thúc (HH:mm, text)
  startTime String @map("start_time") @db.VarChar(20)
  endTime   String @map("end_time") @db.VarChar(20)

  status String @default("SCHEDULED") @db.VarChar(20) // SCHEDULED, CANCELLED, RESCHEDULED, COMPLETED

  cancellationReason String? @map("cancellation_reason") @db.Text

  roomId     String? @map("room_id") @db.VarChar(64)
  location   String? @db.VarChar(255)
  note       String? @db.Text
  instructorId String? @map("instructor_id") @db.Uuid

  supersededBySessionId String? @map("superseded_by_session_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  // Relations
  class    Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  schedule LiveSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  supersededBySession LiveScheduleSession? @relation("LiveScheduleSessionSupersede", fields: [supersededBySessionId], references: [id])
  supersededSessions  LiveScheduleSession[] @relation("LiveScheduleSessionSupersede")
  requests LiveScheduleRequest[]
  attendances ClassAttendance[]

  @@index([classId, sessionDate])
  @@index([scheduleId])
  @@index([status])
  @@unique([classId, sessionDate, startTime, endTime])
  @@map("academy_live_schedule_sessions")
}

model LiveScheduleRequest {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String                    @map("session_id") @db.Uuid
  classId          String?                   @map("class_id") @db.Uuid
  requestedBy      String                    @map("requested_by") @db.Uuid
  type             LiveScheduleRequestType
  status           LiveScheduleRequestStatus @default(PENDING)
  reason           String?                   @db.Text
  requestedDate    DateTime?                 @map("requested_date")
  originalWeekday  Int                       @map("original_weekday")
  originalStartTime String                   @map("original_start_time") @db.VarChar(20)
  originalEndTime  String                    @map("original_end_time") @db.VarChar(20)
  proposedDate     DateTime?                 @map("proposed_date")
  proposedStartTime String?                  @map("proposed_start_time") @db.VarChar(20)
  proposedEndTime  String?                   @map("proposed_end_time") @db.VarChar(20)
  proposedTeacherId String?                  @map("proposed_teacher_id") @db.Uuid
  reviewNote       String?                   @map("review_note") @db.Text
  reviewedBy       String?                   @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?                 @map("reviewed_at")
  metadata         Json?                     @default("{}") @db.JsonB
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @default(now()) @updatedAt @map("updated_at")

  session     LiveScheduleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requester    User         @relation("LiveScheduleRequestRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("LiveScheduleRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  proposedTeacher User?     @relation("LiveScheduleRequestProposedTeacher", fields: [proposedTeacherId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([requestedBy])
  @@index([status])
  @@index([requestedDate])
  @@map("academy_live_schedule_requests")
}




model Enrollment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId          String    @map("class_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  enrolledAt       DateTime  @default(now()) @map("enrolled_at")
  expiresAt        DateTime? @map("expires_at")
  status           String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, COMPLETED, CANCELLED, EXPIRED
  sourceOfferingId String?   @map("source_offering_id") @db.Uuid
  sourceOrderId    String?   @map("source_order_id") @db.Uuid
  companyId        String?   @map("company_id") @db.Uuid
  metadata         Json?     @default("{}") @db.JsonB

  // Relations
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  certificate Certificate?
  review      ClassReview?

  @@index([classId])
  @@index([userId])
  @@index([status])
  @@index([companyId])
  @@map("academy_enrollments")
}

model LearningProgress {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId         String    @map("class_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  contentItemId   String    @map("content_item_id") @db.Uuid
  status          String    @default("NOT_STARTED") @db.VarChar(20) // NOT_STARTED, IN_PROGRESS, COMPLETED
  lastAccessedAt  DateTime? @map("last_accessed_at")
  progressPercent Int       @default(0) @map("progress_percent")

  // Relations
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem ClassContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([userId, contentItemId])
  @@index([classId])
  @@index([userId])
  @@map("academy_learning_progress")
}

model ClassReview {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid

  rating       Int      // 1-5
  title        String?  @db.VarChar(255)
  content      String?  @db.Text
  status       String   @default("PUBLISHED") @db.VarChar(20) // PENDING, PUBLISHED, HIDDEN, REJECTED
  isAnonymous  Boolean  @default(false) @map("is_anonymous")
  metadata     Json?    @default("{}") @db.JsonB
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  class      Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId])
  @@index([classId])
  @@index([userId])
  @@index([status])
  @@map("academy_class_reviews")
}

// --- Assessment / Exam layer ---

model Exam {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId       String?  @map("course_profile_id") @db.Uuid
  title                 String   @db.VarChar(255)
  description           String?  @db.Text
  examType              String   @default("COURSE") @map("exam_type") @db.VarChar(30)
  level                 String?  @db.VarChar(20)
  totalTimeLimitMinutes Int?     @map("total_time_limit_minutes")
  status                String   @default("DRAFT") @db.VarChar(20) // DRAFT, PUBLISHED, ARCHIVED
  settings              Json?    @default("{}") @db.JsonB
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  courseProfile CourseProfile? @relation(fields: [courseProfileId], references: [id], onDelete: SetNull)
  sections      ExamSection[]
  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  @@index([courseProfileId])
  @@index([status])
  @@map("academy_exams")
}

model ExamSection {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId           String  @map("exam_id") @db.Uuid
  title            String  @db.VarChar(255)
  instruction      String? @db.Text
  timeLimitSeconds Int?    @map("time_limit_seconds")
  orderIndex       Int     @map("order_index")
  sectionType      String  @map("section_type") @db.VarChar(50)
  metadata         Json?   @default("{}") @db.JsonB

  // Relations
  exam          Exam                      @relation(fields: [examId], references: [id], onDelete: Cascade)
  examQuestions ExamQuestion[]
  sectionStates ExamAttemptSectionState[]

  @@index([examId, orderIndex])
  @@map("academy_exam_sections")
}

model Question {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  content       String   @db.Text
  mediaUrl      String?  @map("media_url") @db.Text
  questionType  String   @map("question_type") @db.VarChar(30) // SINGLE_CHOICE, MULTIPLE_CHOICE, SHORT_ANSWER, GROUP_PARENT, ...
  options       Json?    @db.JsonB
  correctAnswer Json?    @map("correct_answer") @db.JsonB
  explanation   String?  @db.Text
  level         String?  @db.VarChar(20)
  category      String?  @db.VarChar(50)
  metadata      Json?    @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  parent             Question?           @relation("AcademyQuestionToSub", fields: [parentId], references: [id], onDelete: SetNull)
  subQuestions       Question[]          @relation("AcademyQuestionToSub")
  examQuestions      ExamQuestion[]
  examAttemptDetails ExamAttemptDetail[]
  poolQuestions      PoolQuestion[]

  @@index([parentId])
  @@index([level])
  @@index([category])
  @@map("academy_questions")
}

model ExamQuestion {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId     String  @map("exam_id") @db.Uuid
  sectionId  String  @map("section_id") @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  orderIndex Int     @map("order_index")
  points     Decimal @default(1.00) @db.Decimal(7, 2)
  metadata   Json?   @default("{}") @db.JsonB

  // Relations
  exam     Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  section  ExamSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  details  ExamAttemptDetail[]

  @@index([examId])
  @@index([sectionId])
  @@index([questionId])
  @@map("academy_exam_questions")
}

model ExamAttempt {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId            String    @map("exam_id") @db.Uuid
  classId           String?   @map("class_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  contentItemId     String?   @map("content_item_id") @db.Uuid
  status            String    @default("IN_PROGRESS") @db.VarChar(20) // IN_PROGRESS, SUBMITTED, COMPLETED, ABANDONED
  startedAt         DateTime  @default(now()) @map("started_at")
  submittedAt       DateTime? @map("submitted_at")
  completedAt       DateTime? @map("completed_at")
  rawScore          Decimal?  @map("raw_score") @db.Decimal(7, 2)
  maxScore          Decimal?  @map("max_score") @db.Decimal(7, 2)
  percentage        Decimal?  @db.Decimal(5, 2)
  isPassed          Boolean?  @map("is_passed")
  deadlineAt        DateTime? @map("deadline_at")
  draftAnswers      Json?     @default("{}") @map("draft_answers") @db.JsonB
  metadata          Json?     @default("{}") @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  exam        Exam                      @relation(fields: [examId], references: [id], onDelete: Cascade)
  class       Class?                    @relation(fields: [classId], references: [id], onDelete: SetNull)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem ClassContentItem?         @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  sections    ExamAttemptSectionState[]
  details     ExamAttemptDetail[]

  @@index([examId])
  @@index([classId])
  @@index([userId])
  @@index([status])
  @@map("academy_exam_attempts")
}

model QuestionPool {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String?  @unique @db.VarChar(64)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  courseProfileId String?  @map("course_profile_id") @db.Uuid
  level           String?  @db.VarChar(20)
  category        String?  @db.VarChar(50)
  status          String   @default("DRAFT") @db.VarChar(20) // DRAFT, ACTIVE, ARCHIVED
  metadata        Json?    @default("{}") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  courseProfile CourseProfile? @relation(fields: [courseProfileId], references: [id], onDelete: SetNull)
  poolQuestions PoolQuestion[]

  @@index([courseProfileId])
  @@index([level])
  @@index([category])
  @@index([status])
  @@map("academy_question_pools")
}

model PoolQuestion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poolId     String   @map("pool_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  pool     QuestionPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([poolId, questionId])
  @@index([poolId])
  @@index([questionId])
  @@map("academy_pool_questions")
}

model ExamAttemptSectionState {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId        String    @map("attempt_id") @db.Uuid
  sectionId        String    @map("section_id") @db.Uuid
  status           String    @default("LOCKED") @db.VarChar(20) // LOCKED, IN_PROGRESS, COMPLETED, SKIPPED
  startedAt        DateTime? @map("started_at")
  endedAt          DateTime? @map("ended_at")
  timeSpentSeconds Int       @default(0) @map("time_spent_seconds")

  // Relations
  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([sectionId])
  @@map("academy_exam_attempt_section_states")
}

model ExamAttemptDetail {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  examQuestionId   String   @map("exam_question_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  userAnswer       Json?    @map("user_answer") @db.JsonB
  isCorrect        Boolean? @map("is_correct")
  pointsEarned     Decimal? @map("points_earned") @db.Decimal(7, 2)
  timeSpentSeconds Int?     @map("time_spent_seconds")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  attempt      ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestion ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([examQuestionId])
  @@index([questionId])
  @@map("academy_exam_attempt_details")
}

model Assignment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId     String   @map("class_id") @db.Uuid
  title       String   @db.VarChar(255)
  instruction String?  @db.Text
  attachments String[] @map("attachments")
  maxScore    Decimal? @map("max_score") @db.Decimal(5, 2)
  status      String   @default("DRAFT") @db.VarChar(20)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
  
  @@index([classId])
  @@map("academy_assignments")
}

model AssignmentSubmission {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId         String           @map("assignment_id") @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  status               SubmissionStatus @default(DRAFT)
  grade                Decimal?         @db.Decimal(5, 2)
  feedback             String?          @db.Text
  content              String?          @db.Text
  fileUrls             String[]         @map("file_urls")
  submittedAt          DateTime?        @default(now()) @map("submitted_at")
  gradedAt             DateTime?        @map("graded_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at")

  // Relations
  assignment         Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([userId])
  @@map("academy_assignment_submissions")
}

// --- Commerce layer (academy offerings) ---

model CourseOffering {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String         @unique @db.VarChar(150)
  title         String         @db.VarChar(255)
  description   String?        @db.Text
  originalPrice Decimal        @map("original_price") @db.Decimal(12, 2)
  currency      String         @default("VND") @db.VarChar(10)
  status        OfferingStatus @default(DRAFT)
  type          OrderType      @default(COURSE)
  validFrom     DateTime?      @map("valid_from")
  validTo       DateTime?      @map("valid_to")
  metadata      Json?          @default("{}") @db.JsonB

  submittedForApprovalAt DateTime? @map("submitted_for_approval_at")
  submittedBy            String?   @map("submitted_by") @db.Uuid
  approvedAt            DateTime? @map("approved_at")
  approvedBy            String?   @map("approved_by") @db.Uuid
  rejectedAt            DateTime? @map("rejected_at")
  rejectedBy            String?   @map("rejected_by") @db.Uuid
  rejectionReason       String?   @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")

  // Relations
  classes    CourseOfferingClass[]
  orderItems OrderItem[]

  @@index([status])
  @@map("academy_course_offerings")
}

model CourseOfferingClass {
  offeringId String  @map("offering_id") @db.Uuid
  classId    String  @map("class_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")

  // Relations
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  class    Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([offeringId, classId])
  @@index([classId])
  @@map("academy_course_offering_classes")
}

model ClassAttendance {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String  @map("session_id") @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  status         String  @db.VarChar(20) // PRESENT, ABSENT, LATE, EXCUSED
  recordedAt     DateTime @default(now()) @map("recorded_at")

  session     LiveScheduleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("academy_class_attendances")
}
