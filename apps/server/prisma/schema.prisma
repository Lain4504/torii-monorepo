generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String             @db.VarChar(255)
  slug             String             @unique @db.VarChar(255)
  description      String?
  shortDescription String?            @map("short_description") @db.VarChar(500)
  jlptLevel        String             @map("jlpt_level") @db.VarChar(5)
  thumbnailUrl     String?            @map("thumbnail_url")
  previewVideoUrl  String?            @map("preview_video_url")
  price            Decimal            @default(0.00) @db.Decimal(10, 2)
  discountPrice    Decimal?           @map("discount_price") @db.Decimal(10, 2)
  durationWeeks    Int?               @map("duration_weeks")
  totalLessons     Int                @default(0) @map("total_lessons")
  totalQuizzes     Int                @default(0) @map("total_quizzes")
  totalStudents    Int                @default(0) @map("total_students")
  averageRating    Decimal            @default(0.00) @map("average_rating") @db.Decimal(3, 2)
  totalReviews     Int                @default(0) @map("total_reviews")
  isFree           Boolean            @default(false) @map("is_free")
  tags             String[]           @default([]) @db.VarChar(50)
  learningOutcomes Json               @default("[]") @map("learning_outcomes")
  requirements     Json               @default("[]")
  createdBy        String?            @map("created_by") @db.Uuid
  approvedBy       String?            @map("approved_by") @db.Uuid
  approvedAt       DateTime?          @map("approved_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")
  aiMetadata       Json?              @default("{}") @map("ai_metadata")
  liveConfig       Json?              @map("live_config")
  type             String             @default("vod") @db.VarChar(20)
  status           CourseStatus       @default(draft)
  rejectionReason  String?            @map("rejection_reason")
  instructors      CourseInstructor[]
  enrollments      Enrollment[]
  liveSessions     LiveSession[]
  modules          Module[]
  quizzes          Quiz[]
  reviews          Review[]
  wishlists        Wishlist[]

  @@index([jlptLevel])
  @@index([createdBy])
  @@index([approvedBy])
  @@map("courses")
}

model Module {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  title           String    @db.VarChar(255)
  description     String?
  durationMinutes Int?      @map("duration_minutes")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  aiMetadata      Json?     @default("{}") @map("ai_metadata")
  orderIndex      Int       @default(0) @map("order_index")
  status          String    @default("published") @db.VarChar(20)
  lessons         Lesson[]
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId       String           @map("module_id") @db.Uuid
  title          String           @db.VarChar(255)
  contentType    String           @map("content_type") @db.VarChar(20)
  videoUrl       String?          @map("video_url")
  videoDuration  Int?             @map("video_duration")
  articleContent String?          @map("article_content")
  orderIndex     Int              @default(0) @map("order_index")
  isPreview      Boolean          @default(false) @map("is_preview")
  isUnlocked     Boolean          @default(true) @map("is_unlocked")
  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  aiMetadata     Json?            @default("{}") @map("ai_metadata")
  status         String           @default("published") @db.VarChar(20)
  materials      LessonMaterial[]
  lessonProgress LessonProgress[]
  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizzes        Quiz[]

  @@index([moduleId])
  @@map("lessons")
}

model LessonProgress {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId    String     @map("enrollment_id") @db.Uuid
  lessonId        String     @map("lesson_id") @db.Uuid
  status          String     @default("not_started") @db.VarChar(20)
  watchedDuration Int        @default(0) @map("watched_duration")
  totalDuration   Int        @map("total_duration")
  lastWatchedAt   DateTime   @default(now()) @map("last_watched_at")
  completedAt     DateTime?  @map("completed_at")
  notes           String?
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson          Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model CourseInstructor {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId     String         @map("course_id") @db.Uuid
  lecturerId   String         @map("lecturer_id") @db.Uuid
  isPrimary    Boolean        @default(false) @map("is_primary")
  assignedDate DateTime       @default(now()) @map("assigned_date")
  role         InstructorRole @default(MAIN)
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, lecturerId])
  @@index([courseId])
  @@index([lecturerId])
  @@map("course_instructors")
}

model LiveSession {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  lecturerId  String?  @map("lecturer_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  scheduledAt DateTime @map("scheduled_at")
  duration    Int      @default(90)
  status      String   @default("scheduled")
  meetingId   String?  @map("meeting_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([lecturerId])
  @@map("live_sessions")
}

model LessonMaterial {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  fileAssetId String    @map("file_asset_id") @db.Uuid
  type        String    @db.VarChar(50)
  title       String?   @db.VarChar(255)
  orderIndex  Int       @default(0) @map("order_index")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id])
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, fileAssetId])
  @@index([lessonId])
  @@index([fileAssetId])
  @@map("lesson_materials")
}

model RoomInfo {
  id                 Int            @id @default(autoincrement())
  roomTitle          String         @default("") @map("room_title") @db.VarChar(255)
  roomId             String         @map("room_id") @db.VarChar(64)
  sid                String         @unique @map("sid") @db.VarChar(64)
  joinedParticipants Int            @default(0) @map("joined_participants")
  isRunning          Int            @default(0) @map("is_running")
  isRecording        Int            @default(0) @map("is_recording")
  recorderId         String         @default("") @map("recorder_id") @db.VarChar(36)
  isActiveRtmp       Int            @default(0) @map("is_active_rtmp")
  rtmpNodeId         String         @default("") @map("rtmp_node_id") @db.VarChar(36)
  webhookUrl         String         @default("") @map("webhook_url") @db.VarChar(255)
  isBreakoutRoom     Int            @default(0) @map("is_breakout_room")
  parentRoomId       String         @default("") @map("parent_room_id") @db.VarChar(64)
  creationTime       Int            @default(0) @map("creation_time")
  created            DateTime       @default(now()) @map("created")
  ended              DateTime?      @map("ended")
  modified           DateTime       @default(now()) @updatedAt @map("modified")
  artifacts          RoomArtifact[]

  @@index([roomId, isRunning], map: "idx_room_id")
  @@map("room_info")
}

model RoomFile {
  id        Int      @id @default(autoincrement())
  fileId    String   @unique @map("file_id")
  roomId    String   @map("room_id")
  userId    String   @map("user_id")
  filePath  String   @map("file_path")
  fileType  String   @map("file_type")
  mimeType  String   @map("mime_type")
  fileSize  Float    @default(0) @map("file_size")
  createdAt DateTime @default(now()) @map("created")

  @@index([roomId])
  @@map("room_files")
}

model RoomArtifact {
  id          BigInt   @id @default(autoincrement())
  artifactId  String   @unique @map("artifact_id") @db.VarChar(64)
  roomTableId Int      @map("room_table_id")
  roomId      String   @map("room_id") @db.VarChar(255)
  type        String   @db.VarChar(100)
  metadata    Json?
  created     DateTime @default(now())
  roomInfo    RoomInfo @relation(fields: [roomTableId], references: [id])

  @@index([artifactId], map: "idx_artifact_artifact_id")
  @@index([roomId], map: "idx_artifact_room_id")
  @@index([type], map: "idx_artifact_type")
  @@map("room_artifacts")
}

model RolePermission {
  roleCode       String   @map("role_code") @db.VarChar(50)
  permissionCode String   @map("permission_code") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@id([roleCode, permissionCode])
  @@index([roleCode])
  @@map("role_permissions")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entity      String   @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(255)
  description String
  metadata    Json?
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user        User     @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  password                String?                  @db.VarChar(255)
  email                   String                   @unique @db.VarChar(255)
  displayName             String                   @map("display_name") @db.VarChar(100)
  role                    String                   @default("learner") @db.VarChar(50)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamp(6)
  appMetadata             Json?                    @default("{}") @map("app_metadata")
  avatarUrl               String?                  @map("avatar_url")
  bannedUntil             DateTime?                @map("banned_until") @db.Timestamp(6)
  lastSignInAt            DateTime?                @map("last_sign_in_at") @db.Timestamp(6)
  userMetadata            Json?                    @default("{}") @map("user_metadata")
  verifiedAt              DateTime?                @map("verified_at") @db.Timestamp(6)
  auditLogs               AuditLog[]               @relation("UserAuditLogs")
  comments                Comment[]
  createdCoupons          Coupon[]                 @relation("CouponCreator")
  dailyActivities         DailyActivity[]
  giftEnrollments         Enrollment[]             @relation("GiftEnrollments")
  enrollments             Enrollment[]
  flashcardDecks          FlashcardDeck[]
  flashcardReviewSessions FlashcardReviewSession[]
  flashcardReviews        FlashcardReview[]
  flashcardUserProgress   FlashcardUserProgress[]
  orders                  Order[]
  payments                Payment[]
  reviews                 Review[]
  sessions                Session[]
  handledTickets          Ticket[]                 @relation("HandlerTickets")
  tickets                 Ticket[]                 @relation("UserTickets")
  twoFactorAuth           TwoFactorAuth?
  achievements            UserAchievement[]
  identities              UserIdentity[]
  streak                  UserStreak?
  wishlists               Wishlist[]
  posts                   Post[]
  postLikes               PostLike[]
  commentLikes            CommentLike[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model UserIdentity {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String    @db.VarChar(50)
  providerId   String    @map("provider_id") @db.VarChar(255)
  providerData Json?     @map("provider_data")
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@index([provider])
  @@map("user_identities")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent")
  deviceInfo String?   @map("device_info") @db.VarChar(100)
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model TwoFactorAuth {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  isEnabled       Boolean   @default(false) @map("is_enabled")
  method          String?   @db.VarChar(20)
  totpSecret      String?   @map("totp_secret") @db.VarChar(255)
  totpBackupCodes String[]  @default([]) @map("totp_backup_codes") @db.VarChar(100)
  enabledAt       DateTime? @map("enabled_at") @db.Timestamp(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamp(6)
  failedAttempts  Int       @default(0) @map("failed_attempts")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_auth")
}

model FlashcardDeck {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                   @map("user_id") @db.Uuid
  name              String                   @db.VarChar(255)
  description       String?
  jlptLevel         String?                  @map("jlpt_level") @db.VarChar(5)
  isPublic          Boolean                  @default(false) @map("is_public")
  tags              String[]                 @default([]) @db.VarChar(50)
  cardCount         Int                      @default(0) @map("card_count")
  studiedCount      Int                      @default(0) @map("studied_count")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at")
  aiSettings        Json?                    @default("{\"filters\": [], \"autoGenerate\": false, \"minConfidence\": 0.8, \"requireApproval\": true}") @map("ai_settings")
  lastStudiedAt     DateTime?                @map("last_studied_at")
  masteryPercentage Decimal?                 @map("mastery_percentage") @db.Decimal(5, 2)
  sourceType        String?                  @default("manual") @map("source_type") @db.VarChar(20)
  srsSettings       Json?                    @default("{\"easyBonus\": 1.3, \"newCardsPerDay\": 20, \"maximumInterval\": 36500, \"intervalModifier\": 1.0, \"maxReviewsPerDay\": 200}") @map("srs_settings")
  totalStudyTime    Int                      @default(0) @map("total_study_time")
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewSessions    FlashcardReviewSession[]
  reviews           FlashcardReview[]
  flashcards        Flashcard[]

  @@index([userId])
  @@map("flashcard_decks")
}

model Flashcard {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deckId             String                    @map("deck_id") @db.Uuid
  frontText          String                    @map("front_text")
  backText           String                    @map("back_text")
  exampleSentence    String?                   @map("example_sentence")
  pronunciation      String?
  imageUrl           String?                   @map("image_url")
  audioUrl           String?                   @map("audio_url")
  tags               String[]                  @default([]) @db.VarChar(50)
  difficulty         String                    @default("medium") @db.VarChar(20)
  nextReviewDate     DateTime?                 @map("next_review_date") @db.Date
  intervalDays       Int                       @default(1) @map("interval_days")
  easeFactor         Decimal                   @default(2.50) @map("ease_factor") @db.Decimal(4, 2)
  reviewCount        Int                       @default(0) @map("review_count")
  correctCount       Int                       @default(0) @map("correct_count")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @default(now()) @updatedAt @map("updated_at")
  aiGenerated        Boolean                   @default(false) @map("ai_generated")
  furigana           String?
  generationMetadata Json?                     @default("{}") @map("generation_metadata")
  generationMethod   FlashcardGenerationMethod @default(manual) @map("generation_method")
  isArchived         Boolean                   @default(false) @map("is_archived")
  kanji              String?
  lastReviewDate     DateTime?                 @map("last_review_date") @db.Date
  meanings           Json?                     @default("[]")
  notes              String?
  partOfSpeech       JapanesePartOfSpeech?     @map("part_of_speech")
  sourceDocumentId   String?                   @map("source_document_id") @db.Uuid
  timesStudied       Int                       @default(0) @map("times_studied")
  wordJlptLevel      String?                   @map("word_jlpt_level") @db.VarChar(5)
  reviews            FlashcardReview[]
  userProgress       FlashcardUserProgress[]
  deck               FlashcardDeck             @relation(fields: [deckId], references: [id], onDelete: Cascade)
  sourceDocument     FileAsset?                @relation("FlashcardSourceDocument", fields: [sourceDocumentId], references: [id])

  @@index([deckId])
  @@index([nextReviewDate])
  @@index([aiGenerated])
  @@index([wordJlptLevel])
  @@index([sourceDocumentId])
  @@map("flashcards")
}

model FlashcardUserProgress {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  flashcardId         String         @map("flashcard_id") @db.Uuid
  state               FlashcardState @default(new)
  currentInterval     Int            @default(0) @map("current_interval")
  easeFactor          Decimal        @default(2.50) @map("ease_factor") @db.Decimal(4, 2)
  lastReviewedAt      DateTime?      @map("last_reviewed_at")
  nextReviewDate      DateTime?      @map("next_review_date") @db.Date
  timesReviewed       Int            @default(0) @map("times_reviewed")
  timesCorrect        Int            @default(0) @map("times_correct")
  timesIncorrect      Int            @default(0) @map("times_incorrect")
  consecutiveCorrect  Int            @default(0) @map("consecutive_correct")
  reviewedToday       Int            @default(0) @map("reviewed_today")
  lastReviewDate      DateTime?      @map("last_review_date") @db.Date
  averageResponseTime Int            @default(0) @map("average_response_time")
  lastResponseTime    Int?           @map("last_response_time")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at")
  flashcard           Flashcard      @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId])
  @@index([flashcardId])
  @@index([userId, nextReviewDate])
  @@index([userId, state])
  @@map("flashcard_user_progress")
}

model FlashcardReview {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String                  @map("user_id") @db.Uuid
  flashcardId        String                  @map("flashcard_id") @db.Uuid
  sessionId          String?                 @map("session_id") @db.Uuid
  deckId             String                  @map("deck_id") @db.Uuid
  quality            ReviewQuality
  timeSpent          Int                     @default(0) @map("time_spent")
  previousInterval   Int?                    @map("previous_interval")
  previousEaseFactor Decimal?                @map("previous_ease_factor") @db.Decimal(4, 2)
  previousState      FlashcardState?         @map("previous_state")
  newInterval        Int?                    @map("new_interval")
  newEaseFactor      Decimal?                @map("new_ease_factor") @db.Decimal(4, 2)
  newState           FlashcardState?         @map("new_state")
  newNextReviewDate  DateTime?               @map("new_next_review_date") @db.Date
  reviewDate         DateTime                @default(now()) @map("review_date")
  userAnswer         String?                 @map("user_answer")
  deviceType         String?                 @map("device_type") @db.VarChar(50)
  reviewDuration     Int?                    @map("review_duration")
  createdAt          DateTime                @default(now()) @map("created_at")
  deck               FlashcardDeck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  flashcard          Flashcard               @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  session            FlashcardReviewSession? @relation(fields: [sessionId], references: [id])
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([flashcardId])
  @@index([sessionId])
  @@index([deckId])
  @@index([reviewDate])
  @@map("flashcard_reviews")
}

model FlashcardReviewSession {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  deckId              String            @map("deck_id") @db.Uuid
  startedAt           DateTime          @default(now()) @map("started_at")
  completedAt         DateTime?         @map("completed_at")
  durationSeconds     Int               @default(0) @map("duration_seconds")
  totalCards          Int               @default(0) @map("total_cards")
  newCards            Int               @default(0) @map("new_cards")
  learningCards       Int               @default(0) @map("learning_cards")
  reviewCards         Int               @default(0) @map("review_cards")
  correctCount        Int               @default(0) @map("correct_count")
  incorrectCount      Int               @default(0) @map("incorrect_count")
  hardCount           Int               @default(0) @map("hard_count")
  easyCount           Int               @default(0) @map("easy_count")
  averageResponseTime Int               @default(0) @map("average_response_time")
  masteryScore        Decimal?          @map("mastery_score") @db.Decimal(5, 2)
  deviceType          String?           @map("device_type") @db.VarChar(50)
  studyMode           String?           @map("study_mode") @db.VarChar(50)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  deck                FlashcardDeck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews             FlashcardReview[]

  @@index([userId])
