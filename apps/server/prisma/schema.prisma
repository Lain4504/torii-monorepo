// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==================================================
// ENUMS
// ==================================================

// --- Assessment ---

enum AssignmentType {
  TEXT // Text answer only
  FILE // File upload only
  BOTH // Text + File
}

enum SubmissionStatus {
  DRAFT // Đang soạn (chưa nộp)
  SUBMITTED // Đã nộp
  GRADED // Đã chấm
  RETURNED // Trả lại để sửa
}

// --- Flashcard / SRS ---

enum SrsState {
  LEARNING
  MASTERED
}

// --- Commerce ---

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  CANCELLED
  REFUNDED
  FAILED
}

enum OrderType {
  COURSE
  BUNDLE
  SUBSCRIPTION
}

enum PaymentMethod {
  PAYOS
  BANK_TRANSFER
  MANUAL
}

enum PaymentGateway {
  PAYOS
  MOMO
  STRIPE
}

enum CouponStatus {
  ACTIVE
  INACTIVE
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponScope {
  GLOBAL
  SPECIFIC_OFFERING
}

enum OfferingStatus {
  DRAFT            // Nháp
  PENDING_APPROVAL // Chờ duyệt
  PUBLISHED        // Đang bán (VOD)
  OPENING          // Đang mở bán / tuyển sinh (LIVE)
  ARCHIVED         // Ngừng bán
}

enum ClassMode {
  VOD
  LIVE
}

enum ClassStatus {
  DRAFT            // Nháp (VOD + LIVE)
  PENDING_APPROVAL // Chờ duyệt (LIVE only)
  PUBLISHED        // Đang bán - học ngay (VOD only)
  OPENING          // Đang tuyển sinh (LIVE only)
  ONGOING          // Đang học (LIVE only)
  COMPLETED        // Đã kết thúc (LIVE only)
  ARCHIVED         // Lưu trữ (VOD + LIVE)
}

enum MinStudentsEnforcement {
  STRICT
  NOTIFY
  DISABLED
}

enum LiveScheduleRequestType {
  LEAVE
  RESCHEDULE
}

enum LiveScheduleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}



// --- Support ---

enum TicketType {
  REFUND
  SUPPORT
  ERROR_REPORT
}

enum TicketStatus {
  PENDING
  PROCESSING
  RESOLVED
  CANCELLED
}

// --- Gamification ---

enum ActivityType {
  LESSON_COMPLETE
  QUIZ_ANSWER
  VIDEO_WATCH
  REVIEW
  PRACTICE
  FLASHCARD_REVIEW
  EXAM_COMPLETE
  BLOG_CREATE
  COMMENT_CREATE
  LOGIN
}



enum GamificationTransactionType {
  EARN // Nhận điểm từ hoạt động học tập
  REDEEM // Đổi điểm lấy coupon/quà
  BONUS // Điểm thưởng bonus
  EXPIRATION // Điểm hết hạn
  OTHER // Khác
}

enum GamificationCurrency {
  POINT
  XP
}

