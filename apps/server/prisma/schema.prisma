// Enrollment - Student enrollment in courses
// Based on database.sql (lines 256-272)
model Enrollment {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  courseId             String    @map("course_id") @db.Uuid
  enrollmentDate       DateTime  @default(now()) @map("enrollment_date")
  completionStatus     String    @default("in_progress") @map("completion_status") @db.VarChar(20) // in_progress, completed, dropped
  completionPercentage Decimal   @default(0.00) @map("completion_percentage") @db.Decimal(5, 2)
  lastAccessedAt       DateTime? @map("last_accessed_at")
  completedAt          DateTime? @map("completed_at")
  paymentId            String?   @unique @map("payment_id") @db.Uuid
  orderId              String?   @unique @map("order_id") @db.Uuid
  couponAppliedId      String?   @map("coupon_applied_id") @db.Uuid
  finalPrice           Decimal   @map("final_price") @db.Decimal(10, 2)
  isGift               Boolean   @default(false) @map("is_gift")
  giftMessage          String?   @map("gift_message") @db.Text
  senderId             String?   @map("sender_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sender         User?            @relation("GiftEnrollments", fields: [senderId], references: [id], onDelete: SetNull)
  lessonProgress LessonProgress[]
  certificate    Certificate?

  @@unique([userId, courseId]) // Mỗi user chỉ enroll 1 lần cho 1 course
  @@index([userId])
  @@index([courseId])
  @@index([completionStatus])
  @@index([enrollmentDate])
  @@map("enrollments")
}

enum OrderStatus {
  pending
  processing
  completed
  failed
  cancelled
  timed_out
}

enum PaymentMethod {
  credit_card
  bank_transfer
  momo
  zalopay
  vnpay
  sepay
  mock // For testing
}

enum PaymentGateway {
  stripe
  paypal
  vnpay
  momo
  sepay
  mock // For testing
}

enum OrderType {
  course_purchase
  subscription
  top_up
  gift
}

// Order - Business entity representing a purchase intent (Invoice)
model Order {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  amount               Decimal     @db.Decimal(10, 2)
  currency             String      @default("VND") @db.VarChar(3)
  paymentMethod        String      @map("payment_method") @db.VarChar(50) // credit_card, bank_transfer, momo, zalopay, vnpay
  paymentGateway       String?     @map("payment_gateway") @db.VarChar(50) // stripe, paypal, vnpay, momo
  transactionId        String?     @unique @map("transaction_id") @db.VarChar(100) // Internal transaction ID
  gatewayTransactionId String?     @map("gateway_transaction_id") @db.VarChar(100) // Gateway transaction ID
  status               OrderStatus @default(pending)
  orderType            OrderType   @default(course_purchase) @map("order_type")
  enrollmentId         String?     @map("enrollment_id") @db.Uuid
  couponId             String?     @map("coupon_id") @db.Uuid
  description          String?     @db.Text
  metadata             Json?       @default("{}") // Additional payment data (coupon, discount, invoice, etc.)
  completedAt          DateTime?   @map("completed_at")
  failedAt             DateTime?   @map("failed_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at")

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment   Enrollment?  // Relation defined on Enrollment side (via orderId)
  payments     Payment[]
  coupon       Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([orderType])
  @@index([enrollmentId])
  @@index([couponId])
  @@index([createdAt])
  @@index([transactionId])
  @@map("orders")
}

// Payment - Actual money movement / bank transaction (Receipt)
model Payment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String?  @map("order_id") @db.Uuid
  transactionId String?  @map("transaction_id") @db.VarChar(100) // SePay ID or Ref
  gateway       String?  @db.VarChar(50) // "sepay"
  amount        Decimal? @db.Decimal(10, 2)
  currency      String   @default("VND") @db.VarChar(3)
  content       String?  @db.Text
  status        String?  @db.VarChar(50) // success/fail
  rawResponse   Json?    @map("raw_response") // Full webhook data
  processedAt   DateTime @default(now()) @map("processed_at")

  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String? @map("user_id") @db.Uuid

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

// ============================================
// GAMIFICATION SYSTEM (Duolingo-style)
// ============================================

enum ActivityType {
  LESSON_COMPLETE
  QUIZ_ANSWER
  VIDEO_WATCH
  REVIEW
  PRACTICE
  FLASHCARD_REVIEW
  EXAM_COMPLETE
  BLOG_CREATE
  COMMENT_CREATE
  LOGIN
}

enum AchievementCategory {
  STREAK
  CONSISTENCY
  LEARNING_PROGRESS
  RECOVERY
  SOCIAL
  MASTERY
}

// Thay thế cho UserStreak cũ - Quản lý toàn bộ hồ sơ Gamification của User
model UserGamification {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // --- XP & Level System ---
  level     Int @default(1)
  currentXp Int @default(0) @map("current_xp") // XP hiện tại ở level này
  totalXp   Int @default(0) @map("total_xp") // Tổng XP tích lũy (dùng để đua Top)

  // --- Currency (Economy - Chuẩn bị sẵn cho tương lai) ---
  coins Int @default(0) // Đơn vị tiền tệ chính (kiếm được qua học tập)
  gems  Int @default(0) // Đơn vị cao cấp (nếu có)

  // --- Streak System (Gộp từ UserStreak cũ vào đây) ---
  currentStreak  Int     @default(0) @map("current_streak")
  longestStreak  Int     @default(0) @map("longest_streak")
  lastActiveDate String? @map("last_active_date") @db.VarChar(10) // YYYY-MM-DD
  freezeCount    Int     @default(0) @map("freeze_count") // Số 'bùa' bảo vệ streak

  // --- Stats Aggregate (Lưu sẵn để đỡ phải count từ bảng khác) ---
  totalActiveDays    Int @default(0) @map("total_active_days")
  weeklyActiveCount  Int @default(0) @map("weekly_active_count")
  monthlyActiveCount Int @default(0) @map("monthly_active_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Index tối ưu
  @@index([totalXp(sort: Desc)]) // Index quan trọng nhất để lấy Leaderboard (Bảng xếp hạng)
  @@index([userId])
  @@map("user_gamification")
}

// Daily Activity Log (for audit + analytics)
model DailyActivity {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  date         String       @db.VarChar(10) // YYYY-MM-DD
  activityType ActivityType @map("activity_type")

  // Metadata for analytics
  meta Json? @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, activityType])
  @@index([userId])
  @@index([date])
  @@index([activityType])
  @@map("daily_activities")
}

// Achievement Definitions (seeded data)
model Achievement {
  id       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String              @unique @db.VarChar(50) // e.g., "STREAK_7"
  category AchievementCategory

  // Display
  title       String  @db.VarChar(100)
  description String  @db.Text
  icon        String? @db.VarChar(100) // emoji or icon name

  // Requirements (JSON for flexibility)
  requirements Json @default("{}")

  // Rewards (JSON for flexibility)
  rewards Json @default("{}") // e.g., {"freezeCount": 1, "xp": 100}

  // Metadata
  isActive   Boolean @default(true) @map("is_active")
  orderIndex Int     @default(0) @map("order_index")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  userAchievements UserAchievement[]

  @@index([category])
  @@index([isActive])
  @@map("achievements")
}

// User Achievement Progress
model UserAchievement {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String @map("user_id") @db.Uuid
  achievementId String @map("achievement_id") @db.Uuid

  // Progress tracking
  isUnlocked Boolean @default(false) @map("is_unlocked")
  progress   Json?   @default("{}") // For multi-step achievements

  unlockedAt DateTime? @map("unlocked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([isUnlocked])
  @@map("user_achievements")
}

// ============================================
// Coupon Models
// ============================================

enum CouponStatus {
  active
  inactive
  expired
}

enum CouponDiscountType {
  percentage
  fixed_amount
}

model Coupon {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String              @unique @db.VarChar(50)
  name                  String              @db.VarChar(100)
  description           String?             @db.Text
  
  // Discount Configuration
  discountType          CouponDiscountType  @map("discount_type")
  discountValue         Decimal             @map("discount_value") @db.Decimal(10, 2)
  maxDiscountAmount     Decimal?            @map("max_discount_amount") @db.Decimal(10, 2)
  
  // Conditions
  minOrderAmount        Decimal?            @map("min_order_amount") @db.Decimal(10, 2)
  applicableCourseIds   String[]            @default([]) @map("applicable_course_ids") @db.Uuid
  excludedCourseIds     String[]            @default([]) @map("excluded_course_ids") @db.Uuid
  
  // Validity Period
  validFrom             DateTime            @map("valid_from")
  validUntil            DateTime            @map("valid_until")
  
  // Usage Limits
  usageLimit            Int?                @map("usage_limit")
  usageCount            Int                 @default(0) @map("usage_count")
  userUsageLimit        Int                 @default(1) @map("user_usage_limit")
  
  // Status
  status                CouponStatus        @default(active)
  
  // Ownership
  createdBy             String?             @map("created_by") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at")
  deletedAt             DateTime?           @map("deleted_at")
  
  // Relations
  orders                Order[]
  creator               User?               @relation("CouponCreator", fields: [createdBy], references: [id])
  
  @@index([code])
  @@index([status])
  @@index([validFrom, validUntil])
  @@index([deletedAt])
  @@map("coupons")
}

enum TicketType {
  REFUND
  SUPPORT
  ERROR_REPORT
}

enum TicketStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
}

model Ticket {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  handlerId   String?      @map("handler_id") @db.Uuid
  type        TicketType   @default(SUPPORT)
  status      TicketStatus @default(PENDING)
  subject     String       @db.VarChar(255)
  description String       @db.Text
  metadata    Json?        @default("{}") // Contains courseId, orderId if type is REFUND
  response    String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")

  // Relations
  user    User  @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  handler User? @relation("HandlerTickets", fields: [handlerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([handlerId])
  @@index([status])
  @@index([type])
  @@map("tickets")
}

// Certificate - Issued when a user completes a course
model Certificate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  enrollmentId     String   @unique @map("enrollment_id") @db.Uuid
  certificateCode  String   @unique @map("certificate_code") @db.VarChar(50)
  issueDate        DateTime @default(now()) @map("issue_date")
  fileUrl          String   @map("file_url") @db.Text
  metadata         Json?    @default("{}") 

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}
