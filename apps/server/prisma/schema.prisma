// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String    @db.VarChar(255)
  slug             String    @unique @db.VarChar(255)
  description      String?   @db.Text
  shortDescription String?   @map("short_description") @db.VarChar(500)
  jlptLevel        String    @map("jlpt_level") @db.VarChar(5)
  thumbnailUrl     String?   @map("thumbnail_url") @db.Text
  previewVideoUrl  String?   @map("preview_video_url") @db.Text
  price            Decimal   @default(0.00) @db.Decimal(10, 2)
  discountPrice    Decimal?  @map("discount_price") @db.Decimal(10, 2)
  durationWeeks    Int?      @map("duration_weeks")
  totalLessons     Int       @default(0) @map("total_lessons")
  totalQuizzes     Int       @default(0) @map("total_quizzes")
  totalStudents    Int       @default(0) @map("total_students")
  averageRating    Decimal   @default(0.00) @map("average_rating") @db.Decimal(3, 2)
  totalReviews     Int       @default(0) @map("total_reviews")
  status           String    @default("draft") @db.VarChar(20)
  featured         Boolean   @default(false)
  isFree           Boolean   @default(false) @map("is_free")
  tags             String[]  @default([]) @db.VarChar(50)
  learningOutcomes Json      @default("[]") @map("learning_outcomes")
  requirements     Json      @default("[]")
  createdBy        String?   @map("created_by") @db.Uuid
  approvedBy       String?   @map("approved_by") @db.Uuid
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@index([jlptLevel])
  @@index([status])
  @@index([createdBy])
  @@map("courses")
}

model RoomInfo {
  id                 Int         @id @default(autoincrement())
  roomTitle          String      @default("") @map("room_title")
  roomId             String      @db.VarChar(64) @map("room_id")
  sid                String      @unique @db.VarChar(64) @map("sid")
  joinedParticipants Int         @default(0) @map("joined_participants")
  isRunning          Boolean     @default(false) @map("is_running")
  isRecording        Boolean     @default(false) @map("is_recording")
  recorderId         String      @default("") @db.VarChar(36) @map("recorder_id")
  isActiveRtmp       Boolean     @default(false) @map("is_active_rtmp")
  rtmpNodeId         String      @default("") @db.VarChar(36) @map("rtmp_node_id")
  webhookUrl         String      @default("") @map("webhook_url")
  metadata           Json?       @map("metadata")

  isBreakoutRoom     Boolean     @default(false) @map("is_breakout_room")
  parentRoomId       String      @default("") @db.VarChar(64) @map("parent_room_id")
  creationTime       Int         @default(0) @map("creation_time")
  createdAt          DateTime    @default(now()) @map("created")
  endedAt            DateTime?   @map("ended")
  modified           DateTime    @default(now()) @updatedAt @map("modified")

  recordings         Recording[]

  @@index([roomId, isRunning])
  @@map("room_info")
}

model Recording {
  id               Int      @id @default(autoincrement())
  recordId         String   @unique @db.VarChar(64) @map("record_id")
  roomId           String   @db.VarChar(64) @map("room_id")
  roomSid          String   @db.VarChar(64) @map("room_sid")
  recorderId       String   @db.VarChar(36) @map("recorder_id")
  filePath         String   @map("file_path")
  size             Float    @map("size")
  published        Boolean  @default(true) @map("published")
  metadata         Json?    @map("metadata")
  creationTime     Int      @default(0) @map("creation_time")
  roomCreationTime Int      @default(0) @map("room_creation_time")
  createdAt        DateTime @default(now()) @map("created")
  updatedAt        DateTime @updatedAt @map("modified")
  
  room             RoomInfo @relation(fields: [roomSid], references: [sid])

  @@index([roomId])
  @@map("recordings")
}

model RoomFile {
  id        Int      @id @default(autoincrement())
  fileId    String   @unique @map("file_id")
  roomId    String   @map("room_id")
  userId    String   @map("user_id")
  filePath  String   @map("file_path")
  fileType  String   @map("file_type")
  mimeType  String   @map("mime_type")
  fileSize  Float    @default(0) @map("file_size")
  createdAt DateTime @default(now()) @map("created")

  @@index([roomId])
  @@map("room_files")
}

model User {
  id            String    @id @db.Uuid
  email         String    @unique @db.VarChar(255)
  fullName      String    @map("full_name") @db.VarChar(100)
  phone         String?   @db.VarChar(20)
  avatarUrl     String?   @map("avatar_url") @db.Text
  role          String    @default("learner") @db.VarChar(20)
  status        String    @default("active") @db.VarChar(20)
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        String?   @db.VarChar(10)
  address       String?   @db.Text
  bio           String?   @db.Text
  jlptLevel     String?   @map("jlpt_level") @db.VarChar(5)
  currentPoints Int       @default(0) @map("current_points")
  totalSpent    Decimal   @default(0.00) @map("total_spent") @db.Decimal(10, 2)
  emailVerified Boolean   @default(false) @map("email_verified")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // blogPosts removed - authorId references Supabase Auth, not PostgreSQL users

  @@map("users")
}

// Bảng flashcard - Clone từ SQL schema
model Flashcard {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deckId         String    @map("deck_id") @db.Uuid
  frontText      String    @map("front_text") @db.Text
  backText       String    @map("back_text") @db.Text
  exampleSentence String?  @map("example_sentence") @db.Text
  pronunciation  String?   @db.Text
  imageUrl       String?   @map("image_url") @db.Text
  audioUrl       String?   @map("audio_url") @db.Text
  tags           String[]  @default([]) @db.VarChar(50)
  difficulty     String    @default("medium") @db.VarChar(20)
  nextReviewDate DateTime? @map("next_review_date") @db.Date
  intervalDays   Int       @default(1) @map("interval_days")
  easeFactor     Decimal   @default(2.50) @map("ease_factor") @db.Decimal(4, 2)
  reviewCount    Int       @default(0) @map("review_count")
  correctCount   Int       @default(0) @map("correct_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("flashcards")
}

// File Assets - Source of Truth for all files in the system
model FileAsset {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // File Identification
  fileUrl     String   @unique @map("file_url") @db.Text
  
  // File Details
  mimeType    String?  @map("mime_type") @db.VarChar(100)
  fileSize    BigInt?  @map("file_size")
  isPublic    Boolean  @default(false) @map("is_public")
  
  // Upload Status: 'pending' | 'uploaded' | 'failed'
  status      String   @default("pending") @db.VarChar(20)
  
  // Flexible Metadata (JSONB)
  metadata    Json?    @default("{}") @map("metadata")
  
  // Ownership
  ownerId     String?  @map("owner_id") @db.Uuid
  moduleOrigin String? @map("module_origin") @db.VarChar(50) // 'USER', 'COURSE', 'CHAT'
  
  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([fileUrl])
  @@index([status])
  @@map("file_assets")
}

// =========================
// BLOG & CONTENT MANAGEMENT
// =========================

// Tags (Extended)
model Tag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(50)
  type        String   @default("general") @db.VarChar(20) // general, course, blog
  description String?  @db.Text
  icon        String?  @db.VarChar(50)
  usageCount  Int      @default(0) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  blogPosts   BlogPostTag[]

  @@index([slug])
  @@index([type])
  @@map("tags")
}

// Blog Posts
model BlogPost {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(255)
  excerpt         String?  @db.VarChar(500)
  content         String   @db.Text
  coverImageUrl   String?  @map("cover_image_url") @db.Text
  authorId        String   @map("author_id") @db.Uuid
  status          String   @default("draft") @db.VarChar(20) // draft, published, archived
  publishedAt     DateTime? @map("published_at")
  viewCount       Int      @default(0) @map("view_count")
  likeCount       Int      @default(0) @map("like_count")
  commentCount    Int      @default(0) @map("comment_count")
  seoTitle        String?  @map("seo_title") @db.VarChar(255)
  seoDescription  String?  @map("seo_description") @db.Text
  
  // Extended fields
  readingTime     Int?     @map("reading_time")
  featured        Boolean  @default(false)
  pinned          Boolean  @default(false)
  metaKeywords    String[] @default([]) @map("meta_keywords") @db.VarChar(50)
  ogImageUrl      String?  @map("og_image_url") @db.Text
  relatedPostIds  String[] @default([]) @map("related_post_ids") @db.Uuid

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // authorId references Supabase Auth users, not PostgreSQL users table
  // No foreign key constraint - user exists in Supabase Auth only
  tags            BlogPostTag[]
  images          BlogPostImage[]

  @@index([status])
  @@index([publishedAt(sort: Desc)])
  @@index([authorId])
  @@index([featured])
  @@map("blog_posts")
}

// Blog Post Tags (Many-to-Many)
model BlogPostTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
  @@map("blog_post_tags")
}

// Blog Post Images
model BlogPostImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  imageUrl  String   @map("image_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("blog_post_images")
}

