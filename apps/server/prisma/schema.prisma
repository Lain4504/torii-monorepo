// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  price       Decimal  @default(0) @db.Decimal(10, 2)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  @@map("courses")
}

model RoomInfo {
  id                 Int         @id @default(autoincrement())
  roomTitle          String      @default("") @map("room_title")
  roomId             String      @db.VarChar(64) @map("room_id")
  sid                String      @unique @db.VarChar(64) @map("sid")
  joinedParticipants Int         @default(0) @map("joined_participants")
  isRunning          Boolean     @default(false) @map("is_running")
  isRecording        Boolean     @default(false) @map("is_recording")
  recorderId         String      @default("") @db.VarChar(36) @map("recorder_id")
  isActiveRtmp       Boolean     @default(false) @map("is_active_rtmp")
  rtmpNodeId         String      @default("") @db.VarChar(36) @map("rtmp_node_id")
  webhookUrl         String      @default("") @map("webhook_url")
  metadata           Json?       @map("metadata")

  isBreakoutRoom     Boolean     @default(false) @map("is_breakout_room")
  parentRoomId       String      @default("") @db.VarChar(64) @map("parent_room_id")
  creationTime       Int         @default(0) @map("creation_time")
  createdAt          DateTime    @default(now()) @map("created")
  endedAt            DateTime?   @map("ended")
  modified           DateTime    @default(now()) @updatedAt @map("modified")

  recordings         Recording[]

  @@index([roomId, isRunning])
  @@map("room_info")
}

model Recording {
  id               Int      @id @default(autoincrement())
  recordId         String   @unique @db.VarChar(64) @map("record_id")
  roomId           String   @db.VarChar(64) @map("room_id")
  roomSid          String   @db.VarChar(64) @map("room_sid")
  recorderId       String   @db.VarChar(36) @map("recorder_id")
  filePath         String   @map("file_path")
  size             Float    @map("size")
  published        Boolean  @default(true) @map("published")
  metadata         Json?    @map("metadata")
  creationTime     Int      @default(0) @map("creation_time")
  roomCreationTime Int      @default(0) @map("room_creation_time")
  createdAt        DateTime @default(now()) @map("created")
  updatedAt        DateTime @updatedAt @map("modified")
  
  room             RoomInfo @relation(fields: [roomSid], references: [sid])

  @@index([roomId])
  @@map("recordings")
}

model RoomFile {
  id        Int      @id @default(autoincrement())
  fileId    String   @unique @map("file_id")
  roomId    String   @map("room_id")
  userId    String   @map("user_id")
  filePath  String   @map("file_path")
  fileType  String   @map("file_type")
  mimeType  String   @map("mime_type")
  fileSize  Float    @default(0) @map("file_size")
  createdAt DateTime @default(now()) @map("created")

  @@index([roomId])
  @@map("room_files")
}

model User {
  id            String    @id @db.Uuid
  email         String    @unique @db.VarChar(255)
  fullName      String    @map("full_name") @db.VarChar(100)
  phone         String?   @db.VarChar(20)
  avatarUrl     String?   @map("avatar_url") @db.Text
  role          String    @default("learner") @db.VarChar(20)
  status        String    @default("active") @db.VarChar(20)
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        String?   @db.VarChar(10)
  address       String?   @db.Text
  bio           String?   @db.Text
  jlptLevel     String?   @map("jlpt_level") @db.VarChar(5)
  currentPoints Int       @default(0) @map("current_points")
  totalSpent    Decimal   @default(0.00) @map("total_spent") @db.Decimal(10, 2)
  emailVerified Boolean   @default(false) @map("email_verified")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("users")
}

// Bảng flashcard - Clone từ SQL schema
model Flashcard {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deckId         String    @map("deck_id") @db.Uuid
  frontText      String    @map("front_text") @db.Text
  backText       String    @map("back_text") @db.Text
  exampleSentence String?  @map("example_sentence") @db.Text
  pronunciation  String?   @db.Text
  imageUrl       String?   @map("image_url") @db.Text
  audioUrl       String?   @map("audio_url") @db.Text
  tags           String[]  @default([]) @db.VarChar(50)
  difficulty     String    @default("medium") @db.VarChar(20)
  nextReviewDate DateTime? @map("next_review_date") @db.Date
  intervalDays   Int       @default(1) @map("interval_days")
  easeFactor     Decimal   @default(2.50) @map("ease_factor") @db.Decimal(4, 2)
  reviewCount    Int       @default(0) @map("review_count")
  correctCount   Int       @default(0) @map("correct_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("flashcards")
}

// File Assets - Source of Truth for all files in the system
model FileAsset {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // File Identification
  fileName    String   @map("file_name") @db.Text
  fileKey     String   @unique @map("file_key") @db.Text
  bucketName  String   @map("bucket_name") @db.Text
  
  // System Info
  provider    String   @db.VarChar(50) // 'SUPABASE_STORAGE', 'AWS_S3', 'LOCAL'
  region      String?  @db.VarChar(50)
  
  // File Details
  mimeType    String?  @map("mime_type") @db.VarChar(100)
  fileSize    BigInt?  @map("file_size")
  isPublic    Boolean  @default(false) @map("is_public")
  
  // Flexible Metadata (JSONB)
  metadata    Json?    @default("{}") @map("metadata")
  
  // Ownership & Status
  ownerId     String?  @map("owner_id") @db.Uuid
  moduleOrigin String? @map("module_origin") @db.VarChar(50) // 'USER', 'COURSE', 'CHAT'
  status      String   @default("PENDING") @db.VarChar(20) // 'PENDING', 'UPLOADED', 'DELETED'
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([fileKey])
  @@index([status])
  @@map("file_assets")
}

