// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==================================================
// ENUMS
// ==================================================

// --- Assessment ---

enum AssignmentType {
  TEXT // Text answer only
  FILE // File upload only
  BOTH // Text + File
}

enum SubmissionStatus {
  DRAFT // Đang soạn (chưa nộp)
  SUBMITTED // Đã nộp
  GRADED // Đã chấm
  RETURNED // Trả lại để sửa
}

// --- Flashcard / SRS ---

enum FlashcardState {
  new
  learning
  review
  relearning
}

enum FlashcardGenerationMethod {
  manual
  ai_auto
  ai_assisted
  import
}

enum JapanesePartOfSpeech {
  noun
  verb_ichidan
  verb_godan
  verb_suru
  verb_kuru
  adjective_i
  adjective_na
  adverb
  particle
  conjunction
  interjection
  pronoun
  number
  other
}

enum ReviewQuality {
  ZERO // Again (incorrect)
  ONE // Hard
  TWO // Good
  THREE // Easy
  FOUR // Easy+
}

// --- Commerce ---

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  CANCELLED
  REFUNDED
  FAILED
}

enum OrderType {
  COURSE
  BUNDLE
  SUBSCRIPTION
}

enum PaymentMethod {
  PAYOS
  BANK_TRANSFER
  MANUAL
}

enum PaymentGateway {
  PAYOS
  MOMO
  STRIPE
}

enum CouponStatus {
  ACTIVE
  INACTIVE
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponScope {
  GLOBAL
  SPECIFIC_OFFERING
}

enum OfferingStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// --- Support ---

enum TicketType {
  REFUND
  SUPPORT
  ERROR_REPORT
}

enum TicketStatus {
  PENDING
  PROCESSING
  RESOLVED
  CANCELLED
}

// --- Gamification ---

enum ActivityType {
  LESSON_COMPLETE
  QUIZ_ANSWER
  VIDEO_WATCH
  REVIEW
  PRACTICE
  FLASHCARD_REVIEW
  EXAM_COMPLETE
  BLOG_CREATE
  COMMENT_CREATE
  LOGIN
}

enum AchievementCategory {
  STREAK
  CONSISTENCY
  LEARNING_PROGRESS
  RECOVERY
  SOCIAL
  MASTERY
}

enum BalanceTransactionType {
  TOP_UP // Nạp tiền vào tài khoản
  REFUND // Hoàn tiền từ ticket/order
  PURCHASE // Dùng coin mua khóa học/dịch vụ
  REWARD // Thưởng từ hệ thống
  BONUS // Bonus từ sự kiện
  OTHER // Khác
}

enum GamificationTransactionType {
  EARN // Nhận điểm từ hoạt động học tập
  REDEEM // Đổi điểm lấy coupon/quà
  BONUS // Điểm thưởng bonus
  EXPIRATION // Điểm hết hạn
  OTHER // Khác
}

