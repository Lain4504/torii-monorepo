// 5. ASSESSMENT (LEGACY) — REMOVED
// ==================================================
// Quiz/Assignment/Question/Attempt mới sẽ nằm trong khối `ACADEMY CORE LMS (NEW)` (ở cuối file).

// ==================================================
// 6. FLASHCARD / SRS
// ==================================================

// --- Flashcards ---

model FlashcardDeck {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  jlptLevel    String?  @map("jlpt_level") @db.VarChar(5)
  isPublic     Boolean  @default(false) @map("is_public")
  tags         String[] @default([]) @db.VarChar(50)
  cardCount    Int      @default(0) @map("card_count")
  studiedCount Int      @default(0) @map("studied_count")

  // SRS Settings (Anki-like)
  srsSettings Json? @default("{\"newCardsPerDay\":20,\"maxReviewsPerDay\":200,\"easyBonus\":1.3,\"intervalModifier\":1.0,\"maximumInterval\":36500}") @map("srs_settings")

  // AI Integration Settings
  aiSettings Json?   @default("{\"autoGenerate\":false,\"requireApproval\":true,\"minConfidence\":0.8,\"filters\":[]}") @map("ai_settings")
  sourceType String? @default("manual") @map("source_type") @db.VarChar(20)

  // Activity Tracking
  lastStudiedAt     DateTime? @map("last_studied_at")
  totalStudyTime    Int       @default(0) @map("total_study_time") // seconds
  masteryPercentage Decimal?  @map("mastery_percentage") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards     Flashcard[]
  reviews        FlashcardReview[]
  reviewSessions FlashcardReviewSession[]

  @@index([userId])
  @@map("flashcard_decks")
}

model Flashcard {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deckId          String   @map("deck_id") @db.Uuid
  frontText       String   @map("front_text") @db.Text
  backText        String   @map("back_text") @db.Text
  exampleSentence String?  @map("example_sentence") @db.Text
  pronunciation   String?  @db.Text
  imageUrl        String?  @map("image_url") @db.Text
  audioUrl        String?  @map("audio_url") @db.Text
  tags            String[] @default([]) @db.VarChar(50)
  difficulty      String   @default("medium") @db.VarChar(20)

  // Japanese-specific fields
  furigana      String?               @db.Text
  kanji         String?               @db.Text
  partOfSpeech  JapanesePartOfSpeech? @map("part_of_speech")
  wordJlptLevel String?               @map("word_jlpt_level") @db.VarChar(5)
  meanings      Json?                 @default("[]") // Structured meanings with examples

  // AI Integration fields
  aiGenerated        Boolean                   @default(false) @map("ai_generated")
  sourceDocumentId   String?                   @map("source_document_id") @db.Uuid
  generationMethod   FlashcardGenerationMethod @default(manual) @map("generation_method")
  generationMetadata Json?                     @default("{}") @map("generation_metadata")

  // Metadata
  notes          String?   @db.Text
  isArchived     Boolean   @default(false) @map("is_archived")
  nextReviewDate DateTime? @map("next_review_date")
  lastReviewDate DateTime? @map("last_review_date")
  easeFactor     Decimal?  @map("ease_factor") @db.Decimal(4, 2)
  reviewCount    Int       @default(0) @map("review_count")
  correctCount   Int       @default(0) @map("correct_count")
  incorrectCount Int       @default(0) @map("incorrect_count")
  timesStudied   Int       @default(0) @map("times_studied")
  intervalDays   Int       @default(0) @map("interval_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  deck           FlashcardDeck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  sourceDocument FileAsset?              @relation("FlashcardSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  userProgress   FlashcardUserProgress[]
  reviews        FlashcardReview[]

  @@index([deckId])
  @@index([aiGenerated])
  @@index([wordJlptLevel])
  @@index([sourceDocumentId])
  @@map("flashcards")
}

model FlashcardUserProgress {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  flashcardId String @map("flashcard_id") @db.Uuid

  // Card State (Anki-like)
  state FlashcardState @default(new)

  // SRS Algorithm fields (per-user)
  currentInterval Int       @default(0) @map("current_interval") // Days until next review
  easeFactor      Decimal   @default(2.50) @map("ease_factor") @db.Decimal(4, 2)
  lastReviewedAt  DateTime? @map("last_reviewed_at")
  nextReviewDate  DateTime? @map("next_review_date") @db.Date

  // Review statistics (per-user)
  timesReviewed      Int @default(0) @map("times_reviewed")
  timesCorrect       Int @default(0) @map("times_correct")
  timesIncorrect     Int @default(0) @map("times_incorrect")
  consecutiveCorrect Int @default(0) @map("consecutive_correct")

  // Daily limits
  reviewedToday  Int       @default(0) @map("reviewed_today")
  lastReviewDate DateTime? @map("last_review_date") @db.Date

  // Performance metrics
  averageResponseTime Int  @default(0) @map("average_response_time")
  lastResponseTime    Int? @map("last_response_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId])
  @@index([flashcardId])
  @@index([userId, nextReviewDate])
  @@index([userId, state])
  @@map("flashcard_user_progress")
}

model FlashcardReview {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  flashcardId String  @map("flashcard_id") @db.Uuid
  sessionId   String? @map("session_id") @db.Uuid
  deckId      String  @map("deck_id") @db.Uuid

  // Review result
  quality   ReviewQuality // 0=Again, 1=Hard, 2=Good, 3-4=Easy
  timeSpent Int           @default(0) @map("time_spent") // milliseconds

  // SRS calculation (before review)
  previousInterval   Int?            @map("previous_interval")
  previousEaseFactor Decimal?        @map("previous_ease_factor") @db.Decimal(4, 2)
  previousState      FlashcardState? @map("previous_state")

  // SRS calculation (after review)
  newInterval       Int?            @map("new_interval")
  newEaseFactor     Decimal?        @map("new_ease_factor") @db.Decimal(4, 2)
  newState          FlashcardState? @map("new_state")
  newNextReviewDate DateTime?       @map("new_next_review_date") @db.Date

  // Review metadata
  reviewDate DateTime @default(now()) @map("review_date")
  userAnswer String?  @map("user_answer") @db.Text

  // Analytics
  deviceType     String? @map("device_type") @db.VarChar(50)
  reviewDuration Int?    @map("review_duration")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard               @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  deck      FlashcardDeck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  session   FlashcardReviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([flashcardId])
  @@index([sessionId])
  @@index([deckId])
  @@index([reviewDate])
  @@map("flashcard_reviews")
}

model FlashcardReviewSession {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  deckId String @map("deck_id") @db.Uuid

  // Session tracking
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  durationSeconds Int       @default(0) @map("duration_seconds")

  // Statistics
  totalCards    Int @default(0) @map("total_cards")
  newCards      Int @default(0) @map("new_cards")
  learningCards Int @default(0) @map("learning_cards")
  reviewCards   Int @default(0) @map("review_cards")

  correctCount   Int @default(0) @map("correct_count")
  incorrectCount Int @default(0) @map("incorrect_count")
  hardCount      Int @default(0) @map("hard_count")
  easyCount      Int @default(0) @map("easy_count")

  // Performance
  averageResponseTime Int      @default(0) @map("average_response_time")
  masteryScore        Decimal? @map("mastery_score") @db.Decimal(5, 2)

  // Metadata
  deviceType String? @map("device_type") @db.VarChar(50)
  studyMode  String? @map("study_mode") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck    FlashcardDeck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews FlashcardReview[]

  @@index([userId])
  @@index([deckId])
  @@index([startedAt])
  @@map("flashcard_review_sessions")
}

// ==================================================
// 7. USER & AUTH
// ==================================================

// --- Identity ---

model User {
  id          String @id @default(uuid()) @db.Uuid
  email       String @unique @db.VarChar(255)
  displayName String @map("display_name") @db.VarChar(100)

  // Auth fields
  password String? @db.VarChar(255) // Nullable for OAuth-only users

  // Profile fields
  avatarUrl String? @map("avatar_url") @db.Text

  // Metadata (JSON for flexibility)
  appMetadata  Json? @default("{}") @map("app_metadata") // App-specific data (providers, etc.)
  userMetadata Json? @default("{}") @map("user_metadata") // User profile data from OAuth

  // Role
  role String @default("learner") @db.VarChar(50)

  // Timestamps (replace status field - Supabase pattern)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamp() // null = not verified (pending)
  bannedUntil  DateTime? @map("banned_until") @db.Timestamp() // null = not banned, value = banned until this time
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamp()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp() // null = not deleted, value = soft deleted

  // Relations
  identities              UserIdentity[] // OAuth providers (email, google, etc.)
  sessions                Session[]
  twoFactorAuth           TwoFactorAuth?
  flashcardDecks          FlashcardDeck[]
  flashcardUserProgress   FlashcardUserProgress[] // Per-user flashcard progress
  flashcardReviews        FlashcardReview[] // Flashcard review history
  flashcardReviewSessions FlashcardReviewSession[] // Review sessions
  comments                Comment[]
  auditLogs               AuditLog[]               @relation("UserAuditLogs")
  orders                  Order[]
  tickets                 Ticket[]                 @relation("UserTickets")
  handledTickets          Ticket[]                 @relation("HandlerTickets")
  certificates            Certificate[]
  balance                 UserBalance?

  // Gamification Relations
  gamification    UserGamification?
  dailyActivities DailyActivity[]
  achievements    UserAchievement[]

  // Commerce (New)
  couponUsages CouponUsage[]

  commentLikes CommentLike[]

  // History Relations
  balanceTransactions          BalanceTransaction[]
  gamificationHistories        GamificationHistory[]
  notebooks                    Notebook[]
  blogs                        Blog[]
  // Academy (new core LMS) relations
  academyEnrollments           Enrollment[]
  academyLearningProgresses    LearningProgress[]
  academyExamAttempts          ExamAttempt[]
  academyAssignmentSubmissions AssignmentSubmission[]
  academyClassesTaught         Class[]                @relation("AcademyClassTeacher")

  @@index([email])
  @@index([role])
  @@map("users")
}

model UserIdentity {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Provider info
  provider   String @db.VarChar(50) // 'email', 'google', etc.
  providerId String @map("provider_id") @db.VarChar(255) // Provider's user ID

  // Provider metadata
  providerData Json? @map("provider_data") // Raw data from provider

  // Timestamps
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamp()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId]) // Prevent duplicate provider accounts
  @@index([userId])
  @@index([provider])
  @@map("user_identities")
}

model Session {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64) // SHA-256 hash

  // Device & Metadata
  deviceInfo String? @map("device_info") @db.VarChar(100) // e.g., "iPhone 13, iOS 15" or "Chrome on Windows"

  expiresAt DateTime  @map("expires_at") @db.Timestamp()
  revokedAt DateTime? @map("revoked_at") @db.Timestamp()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model TwoFactorAuth {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // 2FA Status
  isEnabled Boolean @default(false) @map("is_enabled")
  method    String? @db.VarChar(20) // Currently only 'totp' supported (Google Authenticator)

  // TOTP Configuration (for Google Authenticator)
  totpSecret      String?  @map("totp_secret") @db.VarChar(255) // Encrypted with AES-256-GCM
  totpBackupCodes String[] @default([]) @map("totp_backup_codes") @db.VarChar(100) // Hashed with Argon2

  // Security & Metadata
  enabledAt      DateTime? @map("enabled_at") @db.Timestamp()
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamp()
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamp()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_auth")
}

// --- Permissions & Audit ---

model RolePermission {
  roleCode       String   @map("role_code") @db.VarChar(50)
  permissionCode String   @map("permission_code") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@id([roleCode, permissionCode])
  @@index([roleCode])
  @@map("role_permissions")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Who performed the action
  userId String @map("user_id") @db.Uuid

  // What action was performed
  action   String  @db.VarChar(100) // e.g., "permission.grant", "user.create", "course.delete"
  entity   String  @db.VarChar(100) // e.g., "role_permission", "user", "course"
  entityId String? @map("entity_id") @db.VarChar(255) // ID of affected entity

  // Action details
  description String @db.Text // Human-readable description
  metadata    Json? // Flexible JSON for action-specific data

  // State changes (for updates)
  oldValues Json? @map("old_values") // Previous state
  newValues Json? @map("new_values") // New state

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()

  // Relations
  user User @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// --- Orders & Payments ---

model Order {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String        @unique @db.VarChar(50) // ORD-20260306-XXXX
  userId        String        @map("user_id") @db.Uuid
  status        OrderStatus   @default(PENDING)
  subTotal      Decimal       @map("sub_total") @db.Decimal(12, 2)
  discountTotal Decimal       @map("discount_total") @db.Decimal(12, 2)
  grandTotal    Decimal       @map("grand_total") @db.Decimal(12, 2)
  currency      String        @default("VND") @db.VarChar(10)
  couponCode    String?       @map("coupon_code") @db.VarChar(50)
  couponId      String?       @map("coupon_id") @db.Uuid
  note          String?       @db.Text
  paymentMethod PaymentMethod @map("payment_method")
  metadata      Json?         @default("{}") @db.JsonB
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon       Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  transactions Transaction[]
  usages       CouponUsage[]
  enrollments  Enrollment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("academy_orders")
}

model OrderItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  offeringId       String  @map("offering_id") @db.Uuid
  price            Decimal @db.Decimal(12, 2)
  offeringSnapshot Json    @map("offering_snapshot") @db.JsonB

  // Relations
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([offeringId])
  @@map("academy_order_items")
}

model Transaction {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  gateway         PaymentGateway
  transactionCode String?        @map("transaction_code") @db.VarChar(100)
  amount          Decimal        @db.Decimal(12, 2)
  status          String         @db.VarChar(20) // PENDING, SUCCESS, FAILED
  responsePayload Json?          @map("response_payload") @db.JsonB
  createdAt       DateTime       @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionCode])
  @@map("academy_transactions")
}

// --- Coupons & Wishlist ---

model Coupon {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String             @unique @db.VarChar(50)
  description       String?            @db.Text
  discountType      CouponDiscountType @map("discount_type")
  discountValue     Decimal            @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?           @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderValue     Decimal?           @map("min_order_value") @db.Decimal(12, 2)
  usageLimit        Int?               @map("usage_limit")
  usageCount        Int                @default(0) @map("usage_count")
  perUserLimit      Int                @default(1) @map("per_user_limit")
  startDate         DateTime?          @map("start_date")
  endDate           DateTime?          @map("end_date")
  status            CouponStatus       @default(ACTIVE)
  scope             CouponScope        @default(GLOBAL)
  metadata          Json?              @default("{}") @db.JsonB
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")

  // Relations
  orders Order[]
  usages CouponUsage[]

  @@map("academy_coupons")
}

model CouponUsage {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId String   @map("coupon_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  orderId  String   @map("order_id") @db.Uuid
  usedAt   DateTime @default(now()) @map("used_at")

  // Relations
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade) // Added implicitly if needed

  @@index([couponId])
  @@index([userId])
  @@map("academy_coupon_usages")
}

// Wishlist (legacy course_run) removed; academy wishlist will be reintroduced against CourseOffering/Class later.

// ==================================================
// 9. GAMIFICATION
// ==================================================

// --- Gamification ---

model UserGamification {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // --- XP & Level System ---
  level     Int @default(1)
  currentXp Int @default(0) @map("current_xp") // XP hiện tại ở level này
  totalXp   Int @default(0) @map("total_xp") // Tổng XP tích lũy (dùng để đua Top)

  // --- Currency (Economy - Chuẩn bị sẵn cho tương lai) ---
  points Int @default(0) // Điểm thưởng dùng để đổi mã giảm giá
  gems   Int @default(0) // Đơn vị cao cấp (nếu có)

  // --- Streak System (Gộp từ UserStreak cũ vào đây) ---
  currentStreak  Int     @default(0) @map("current_streak")
  longestStreak  Int     @default(0) @map("longest_streak")
  lastActiveDate String? @map("last_active_date") @db.VarChar(10) // YYYY-MM-DD
  freezeCount    Int     @default(0) @map("freeze_count") // Số 'bùa' bảo vệ streak

  // --- Stats Aggregate (Lưu sẵn để đỡ phải count từ bảng khác) ---
  totalActiveDays    Int @default(0) @map("total_active_days")
  weeklyActiveCount  Int @default(0) @map("weekly_active_count")
  monthlyActiveCount Int @default(0) @map("monthly_active_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Index tối ưu
  @@index([totalXp(sort: Desc)]) // Index quan trọng nhất để lấy Leaderboard (Bảng xếp hạng)
  @@index([userId])
  @@map("user_gamification")
}

model UserBalance {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String @unique @map("user_id") @db.Uuid
  balance Int    @default(0)

  aiRoleplayTrialLimit  Int @default(3) @map("ai_roleplay_trial_limit")
  liveMeetingTrialLimit Int @default(3) @map("live_meeting_trial_limit")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_balances")
}

model DailyActivity {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  date         String       @db.VarChar(10) // YYYY-MM-DD
  activityType ActivityType @map("activity_type")

  // Metadata for analytics
  meta Json? @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, activityType])
  @@index([userId])
  @@index([date])
  @@index([activityType])
  @@map("daily_activities")
}

model Achievement {
  id       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String              @unique @db.VarChar(50) // e.g., "STREAK_7"
  category AchievementCategory

  // Display
  title       String  @db.VarChar(100)
  description String  @db.Text
  icon        String? @db.VarChar(100) // emoji or icon name

  // Requirements (JSON for flexibility)
  requirements Json @default("{}")

  // Rewards (JSON for flexibility)
  rewards Json @default("{}") // e.g., {"freezeCount": 1, "xp": 100}

  // Metadata
  isActive   Boolean @default(true) @map("is_active")
  orderIndex Int     @default(0) @map("order_index")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  userAchievements UserAchievement[]

  @@index([category])
  @@index([isActive])
  @@map("achievements")
}

model UserAchievement {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String @map("user_id") @db.Uuid
  achievementId String @map("achievement_id") @db.Uuid

  // Progress tracking
  isUnlocked Boolean @default(false) @map("is_unlocked")
  progress   Json?   @default("{}") // For multi-step achievements

  unlockedAt DateTime? @map("unlocked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([isUnlocked])
  @@map("user_achievements")
}

model PointReward {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String             @db.VarChar(100)
  description       String?            @db.Text
  points            Int
  discountType      CouponDiscountType @map("discount_type")
  discountValue     Decimal            @map("discount_value") @db.Decimal(10, 2)
  maxDiscountAmount Decimal?           @map("max_discount_amount") @db.Decimal(10, 2)
  minOrderAmount    Decimal?           @map("min_order_amount") @db.Decimal(10, 2)

  validDuration Int?    @default(30) @map("valid_duration") // days
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("point_rewards")
}

// --- Finance Ledger ---

model BalanceTransaction {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  amount      Int // Số tiền biến động (dùng Int vì UserBalance dùng Int)
  type        BalanceTransactionType
  description String?                @db.Text
  metadata    Json?                  @default("{}") // Lưu trữ orderId, ticketId, v.v.
  createdAt   DateTime               @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("balance_transactions")
}

model GamificationHistory {
  id           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                      @map("user_id") @db.Uuid
  amount       Int // Số điểm biến động
  type         GamificationTransactionType
  activityType ActivityType?               @map("activity_type")
  description  String?                     @db.Text
  metadata     Json?                       @default("{}") // Lưu trữ achievementId, v.v.
  createdAt    DateTime                    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([activityType])
  @@index([createdAt])
  @@map("gamification_histories")
}

// ==================================================
// 10. CONTENT & SOCIAL  (Blog / Discussion / Notification)
// ==================================================

// --- Files ---

model FileAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // File Identification
  fileUrl String @unique @map("file_url") @db.Text

  // File Details
  mimeType String? @map("mime_type") @db.VarChar(100)
  fileSize BigInt? @map("file_size")
  isPublic Boolean @default(false) @map("is_public")

  // Upload Status: 'pending' | 'uploaded' | 'failed'
  status String @default("pending") @db.VarChar(20)

  // Flexible Metadata (JSONB)
  metadata     Json?   @default("{}") @map("metadata")
  ownerId      String? @map("owner_id") @db.Uuid
  moduleOrigin String? @map("module_origin") @db.VarChar(50) // 'USER', 'COURSE', 'CHAT'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  flashcardSourceDocs Flashcard[] @relation("FlashcardSourceDocument")

  @@index([ownerId])
  @@index([fileUrl])
  @@index([status])
  @@map("file_assets")
}

// --- Blog ---

model Blog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String    @db.VarChar(255)
  slug           String    @unique @db.VarChar(255)
  description    String?   @db.VarChar(255)
  content        String    @db.Text
  coverImageUrl  String?   @map("cover_image_url") @db.Text
  authorId       String    @map("author_id") @db.Uuid
  status         String    @default("draft") @db.VarChar(20) // draft, published, archived
  publishedAt    DateTime? @map("published_at")
  viewCount      Int       @default(0) @map("view_count")
  commentCount   Int       @default(0) @map("comment_count")
  seoTitle       String?   @map("seo_title") @db.VarChar(255)
  seoDescription String?   @map("seo_description") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([publishedAt(sort: Desc)])
  @@index([authorId])
  @@map("blogs")
}

// --- Discussion & Social ---

model Comment {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String  @map("user_id") @db.Uuid
  parentCommentId String? @map("parent_comment_id") @db.Uuid // For nested replies

  content   String   @db.Text
  status    String   @default("approved") @db.VarChar(20) // pending, approved, spam, deleted
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?        @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies Comment[]       @relation("CommentReplies")
  likes   CommentLike[]
  targets CommentTarget[]

  @@index([userId])
  @@index([parentCommentId])
  @@index([createdAt(sort: Desc)])
  @@map("comments")
}

model CommentTarget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commentId  String   @map("comment_id") @db.Uuid
  targetId   String   @map("target_id") @db.Uuid
  targetType String   @map("target_type") @db.VarChar(20) // BLOG, COURSE_RUN, etc.
  createdAt  DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, targetId, targetType])
  @@index([targetId, targetType])
  @@map("comment_targets")
}

model CommentLike {
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

// DiscussionTopic (legacy course_run) removed; will be redesigned for `academy` later.

// --- Notifications ---

model Notification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  title            String    @db.VarChar(255)
  message          String    @db.Text
  notificationType String?   @map("notification_type") @db.VarChar(50)
  metadata         Json?     @map("data")
  isRead           Boolean   @default(false) @map("is_read")
  readAt           DateTime? @map("read_at")
  sentVia          String[]  @default([]) @map("sent_via") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ==================================================
// 11. SUPPORT & MISC
// ==================================================

// --- Support ---

model Ticket {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  handlerId   String?      @map("handler_id") @db.Uuid
  type        TicketType   @default(SUPPORT)
  status      TicketStatus @default(PENDING)
  subject     String       @db.VarChar(255)
  description String       @db.Text
  classId     String?      @map("class_id") @db.Uuid
  metadata    Json?        @default("{}") // Contains originalOrderId if type is REFUND

  response  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user    User   @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  handler User?  @relation("HandlerTickets", fields: [handlerId], references: [id], onDelete: SetNull)
  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([handlerId])
  @@index([status])
  @@index([type])
  @@index([classId])
  @@map("tickets")
}

model Certificate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  classId         String   @map("class_id") @db.Uuid
  enrollmentId    String   @unique @map("enrollment_id") @db.Uuid
  certificateCode String   @unique @map("certificate_code") @db.VarChar(50)
  issueDate       DateTime @default(now()) @map("issue_date")
  fileUrl         String   @map("file_url") @db.Text
  metadata        Json?    @default("{}")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([classId])
  @@map("certificates")
}

// --- Notes ---

model Notebook {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  name        String  @db.VarChar(255)
  description String? @db.Text
  isPublic    Boolean @default(false) @map("is_public")
  entryCount  Int     @default(0) @map("entry_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries NoteEntry[]

  @@unique([userId, name])
  @@index([userId])
  @@map("notebooks")
}

model NoteEntry {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notebookId   String  @map("notebook_id") @db.Uuid
  word         String  @db.VarChar(255)
  phonetic     String? @db.VarChar(255)
  meaning      String  @db.Text
  note         String? @db.Text
  partOfSpeech String  @default("other") @map("part_of_speech") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([notebookId])
  @@map("note_entries")
}

// ==================================================
// 12. ACADEMY CORE LMS (NEW)
// ==================================================

// NOTE: Các model dưới đây là core schema mới cho service `academy`.
// Chúng không dùng lại CourseMaster/CourseRun cũ, mà tạo domain mới sạch hơn.

// --- Content layer ---

model CourseProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique @db.VarChar(100)
  title           String   @db.VarChar(255)
  shortTitle      String?  @map("short_title") @db.VarChar(100)
  description     String?  @db.Text
  subject         String?  @db.VarChar(100)
  level           String?  @db.VarChar(50)
  defaultLanguage String?  @map("default_language") @db.VarChar(20)
  thumbnailUrl    String?  @map("thumbnail_url") @db.Text
  metadata        Json?    @default("{}") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  editions            CourseEdition[]
  lessons             Lesson[]
  quizTemplates       QuizTemplate[]
  assignmentTemplates AssignmentTemplate[]
  classes             Class[]
  exams               Exam[]

  @@index([subject])
  @@index([level])
  @@map("academy_course_profiles")
}

model CourseEdition {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId  String    @map("course_profile_id") @db.Uuid
  editionTag       String    @map("edition_tag") @db.VarChar(50)
  isCurrent        Boolean   @default(false) @map("is_current")
  status           String    @default("DRAFT") @db.VarChar(20)
  syllabusSnapshot Json?     @map("syllabus_snapshot") @db.JsonB
  changelog        String?   @db.Text
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  courseProfile CourseProfile @relation(fields: [courseProfileId], references: [id], onDelete: Cascade)
  chapters      Chapter[]
  classes       Class[]

  @@unique([courseProfileId, editionTag])
  @@index([courseProfileId])
  @@index([isCurrent])
  @@map("academy_course_editions")
}

model Chapter {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseEditionId  String   @map("course_edition_id") @db.Uuid
  title            String   @db.VarChar(255)
  description      String?  @db.Text
  orderIndex       Int      @map("order_index")
  estimatedMinutes Int?     @map("estimated_minutes")
  status           String   @default("DRAFT") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  courseEdition CourseEdition @relation(fields: [courseEditionId], references: [id], onDelete: Cascade)
  items         ChapterItem[]

  @@index([courseEditionId, orderIndex])
  @@map("academy_chapters")
}

model ChapterItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId   String @map("chapter_id") @db.Uuid
  title       String @db.VarChar(255)
  kind        String @db.VarChar(50) // LESSON, QUIZ_TEMPLATE, ASSIGNMENT_TEMPLATE, READING, PROJECT, ...
  referenceId String @map("reference_id") @db.Uuid
  orderIndex  Int    @map("order_index")
  metadata    Json?  @default("{}") @db.JsonB

  // Relations
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, orderIndex])
  @@index([referenceId])
  @@map("academy_chapter_items")
}

model Lesson {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId String   @map("course_profile_id") @db.Uuid
  title           String   @db.VarChar(255)
  contentType     String   @map("content_type") @db.VarChar(50) // VIDEO, HTML, MARKDOWN, EXTERNAL_LINK, ...
  contentUrl      String?  @map("content_url") @db.Text
  contentBody     String?  @map("content_body") @db.Text
  attachments     Json?    @default("[]") @db.JsonB
  metadata        Json?    @default("{}") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  courseProfile    CourseProfile      @relation(fields: [courseProfileId], references: [id], onDelete: Cascade)
  learningProgress LearningProgress[]

  @@index([courseProfileId])
  @@map("academy_lessons")
}

model QuizTemplate {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId            String   @map("course_profile_id") @db.Uuid
  title                      String   @db.VarChar(255)
  description                String?  @db.Text
  questionPoolId             String?  @map("question_pool_id") @db.Uuid
  defaultTimeLimitMinutes    Int?     @map("default_time_limit_minutes")
  defaultMaxAttempts         Int      @map("default_max_attempts")
  defaultPassingScorePercent Decimal? @map("default_passing_score_percent") @db.Decimal(5, 2)
  settings                   Json?    @default("{}") @db.JsonB
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  courseProfile    CourseProfile     @relation(fields: [courseProfileId], references: [id], onDelete: Cascade)
  classAssessments ClassAssessment[]

  @@index([courseProfileId])
  @@index([questionPoolId])
  @@map("academy_quiz_templates")
}

model AssignmentTemplate {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId           String         @map("course_profile_id") @db.Uuid
  title                     String         @db.VarChar(255)
  description               String?        @db.Text
  defaultType               AssignmentType @map("default_type")
  defaultMaxScore           Decimal?       @map("default_max_score") @db.Decimal(7, 2)
  defaultRubric             Json?          @default("{}") @map("default_rubric") @db.JsonB
  defaultSubmissionSettings Json?          @default("{}") @map("default_submission_settings") @db.JsonB
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @default(now()) @updatedAt @map("updated_at")

  // Relations
  courseProfile    CourseProfile          @relation(fields: [courseProfileId], references: [id], onDelete: Cascade)
  classAssessments ClassAssessment[]
  submissions      AssignmentSubmission[]

  @@index([courseProfileId])
  @@map("academy_assignment_templates")
}

// --- Delivery layer ---

model Class {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId   String    @map("course_profile_id") @db.Uuid
  courseEditionId   String    @map("course_edition_id") @db.Uuid
  code              String    @unique @db.VarChar(150)
  name              String    @db.VarChar(255)
  mode              String    @db.VarChar(20) // VOD, LIVE, BLENDED
  term              String?   @db.VarChar(100)
  batch             String?   @db.VarChar(100)
  startDate         DateTime? @map("start_date")
  endDate           DateTime? @map("end_date")
  enrollmentOpenAt  DateTime? @map("enrollment_open_at")
  enrollmentCloseAt DateTime? @map("enrollment_close_at")
  minStudents       Int?      @map("min_students")
  maxStudents       Int?      @map("max_students")
  status            String    @default("DRAFT") @db.VarChar(20) // DRAFT, ENROLLING, IN_PROGRESS, COMPLETED, CANCELLED
  primaryTeacherId  String?   @map("primary_teacher_id") @db.Uuid
  companyId         String?   @map("company_id") @db.Uuid
  settings          Json?     @default("{}") @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  courseProfile         CourseProfile          @relation(fields: [courseProfileId], references: [id], onDelete: Cascade)
  courseEdition         CourseEdition          @relation(fields: [courseEditionId], references: [id], onDelete: Cascade)
  primaryTeacher        User?                  @relation("AcademyClassTeacher", fields: [primaryTeacherId], references: [id], onDelete: SetNull)
  enrollments           Enrollment[]
  schedules             ClassSchedule[]
  assessments           ClassAssessment[]
  learningProgress      LearningProgress[]
  examAttempts          ExamAttempt[]
  tickets               Ticket[]
  certificates          Certificate[]
  assignmentSubmissions AssignmentSubmission[]
  offeringLinks         CourseOfferingClass[]

  @@index([courseProfileId])
  @@index([courseEditionId])
  @@index([mode])
  @@index([status])
  @@index([companyId])
  @@map("academy_classes")
}

model ClassSchedule {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId   String  @map("class_id") @db.Uuid
  weekday   Int // 0-6
  startTime String  @map("start_time") @db.VarChar(20)
  endTime   String  @map("end_time") @db.VarChar(20)
  location  String? @db.VarChar(255)
  note      String? @db.Text

  // Relations
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("academy_class_schedules")
}

model ClassAssessment {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId                  String    @map("class_id") @db.Uuid
  kind                     String    @db.VarChar(20) // QUIZ, ASSIGNMENT
  quizTemplateId           String?   @map("quiz_template_id") @db.Uuid
  assignmentTemplateId     String?   @map("assignment_template_id") @db.Uuid
  titleOverride            String?   @map("title_override") @db.VarChar(255)
  deadline                 DateTime? @db.Timestamp(6)
  weight                   Decimal?  @db.Decimal(5, 2)
  maxAttemptsOverride      Int?      @map("max_attempts_override")
  timeLimitOverrideMinutes Int?      @map("time_limit_override_minutes")
  maxScoreOverride         Decimal?  @map("max_score_override") @db.Decimal(7, 2)
  settings                 Json?     @default("{}") @db.JsonB
  status                   String    @default("DRAFT") @db.VarChar(20) // DRAFT, PUBLISHED, CLOSED
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  class                 Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  quizTemplate          QuizTemplate?          @relation(fields: [quizTemplateId], references: [id], onDelete: SetNull)
  assignmentTemplate    AssignmentTemplate?    @relation(fields: [assignmentTemplateId], references: [id], onDelete: SetNull)
  examAttempts          ExamAttempt[]
  assignmentSubmissions AssignmentSubmission[]

  @@index([classId])
  @@index([status])
  @@map("academy_class_assessments")
}

model Enrollment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId          String    @map("class_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  enrolledAt       DateTime  @default(now()) @map("enrolled_at")
  expiresAt        DateTime? @map("expires_at")
  status           String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, COMPLETED, CANCELLED, EXPIRED
  sourceOfferingId String?   @map("source_offering_id") @db.Uuid
  sourceOrderId    String?   @map("source_order_id") @db.Uuid
  companyId        String?   @map("company_id") @db.Uuid
  metadata         Json?     @default("{}") @db.JsonB

  // Relations
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  certificate Certificate?

  @@index([classId])
  @@index([userId])
  @@index([status])
  @@index([companyId])
  @@map("academy_enrollments")
}

model LearningProgress {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId         String    @map("class_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  lessonId        String    @map("lesson_id") @db.Uuid
  status          String    @default("NOT_STARTED") @db.VarChar(20) // NOT_STARTED, IN_PROGRESS, COMPLETED
  lastAccessedAt  DateTime? @map("last_accessed_at")
  progressPercent Int       @default(0) @map("progress_percent")

  // Relations
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([classId, userId, lessonId])
  @@index([classId])
  @@index([userId])
  @@map("academy_learning_progress")
}

// --- Assessment / Exam layer ---

model Exam {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId       String?  @map("course_profile_id") @db.Uuid
  title                 String   @db.VarChar(255)
  description           String?  @db.Text
  examType              String   @default("COURSE") @map("exam_type") @db.VarChar(30)
  level                 String?  @db.VarChar(20)
  totalTimeLimitMinutes Int?     @map("total_time_limit_minutes")
  status                String   @default("DRAFT") @db.VarChar(20) // DRAFT, PUBLISHED, ARCHIVED
  settings              Json?    @default("{}") @db.JsonB
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  courseProfile CourseProfile? @relation(fields: [courseProfileId], references: [id], onDelete: SetNull)
  sections      ExamSection[]
  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  @@index([courseProfileId])
  @@index([status])
  @@map("academy_exams")
}

model ExamSection {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId           String  @map("exam_id") @db.Uuid
  title            String  @db.VarChar(255)
  instruction      String? @db.Text
  timeLimitSeconds Int?    @map("time_limit_seconds")
  orderIndex       Int     @map("order_index")
  sectionType      String  @map("section_type") @db.VarChar(50)
  metadata         Json?   @default("{}") @db.JsonB

  // Relations
  exam          Exam                      @relation(fields: [examId], references: [id], onDelete: Cascade)
  examQuestions ExamQuestion[]
  sectionStates ExamAttemptSectionState[]

  @@index([examId, orderIndex])
  @@map("academy_exam_sections")
}

model Question {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  content       String   @db.Text
  mediaUrl      String?  @map("media_url") @db.Text
  questionType  String   @map("question_type") @db.VarChar(30) // SINGLE_CHOICE, MULTIPLE_CHOICE, SHORT_ANSWER, GROUP_PARENT, ...
  options       Json?    @db.JsonB
  correctAnswer Json?    @map("correct_answer") @db.JsonB
  explanation   String?  @db.Text
  metadata      Json?    @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  parent             Question?           @relation("AcademyQuestionToSub", fields: [parentId], references: [id], onDelete: SetNull)
  subQuestions       Question[]          @relation("AcademyQuestionToSub")
  examQuestions      ExamQuestion[]
  examAttemptDetails ExamAttemptDetail[]

  @@index([parentId])
  @@map("academy_questions")
}

model ExamQuestion {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId     String  @map("exam_id") @db.Uuid
  sectionId  String  @map("section_id") @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  orderIndex Int     @map("order_index")
  points     Decimal @default(1.00) @db.Decimal(7, 2)
  metadata   Json?   @default("{}") @db.JsonB

  // Relations
  exam     Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  section  ExamSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  details  ExamAttemptDetail[]

  @@index([examId])
  @@index([sectionId])
  @@index([questionId])
  @@map("academy_exam_questions")
}

model ExamAttempt {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId            String    @map("exam_id") @db.Uuid
  classId           String?   @map("class_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  classAssessmentId String?   @map("class_assessment_id") @db.Uuid
  status            String    @default("IN_PROGRESS") @db.VarChar(20) // IN_PROGRESS, SUBMITTED, COMPLETED, ABANDONED
  startedAt         DateTime  @default(now()) @map("started_at")
  submittedAt       DateTime? @map("submitted_at")
  completedAt       DateTime? @map("completed_at")
  rawScore          Decimal?  @map("raw_score") @db.Decimal(7, 2)
  maxScore          Decimal?  @map("max_score") @db.Decimal(7, 2)
  percentage        Decimal?  @db.Decimal(5, 2)
  isPassed          Boolean?  @map("is_passed")
  draftAnswers      Json?     @default("{}") @map("draft_answers") @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  exam            Exam                      @relation(fields: [examId], references: [id], onDelete: Cascade)
  class           Class?                    @relation(fields: [classId], references: [id], onDelete: SetNull)
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classAssessment ClassAssessment?          @relation(fields: [classAssessmentId], references: [id], onDelete: SetNull)
  sections        ExamAttemptSectionState[]
  details         ExamAttemptDetail[]

  @@index([examId])
  @@index([classId])
  @@index([userId])
  @@index([status])
  @@map("academy_exam_attempts")
}

model ExamAttemptSectionState {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId        String    @map("attempt_id") @db.Uuid
  sectionId        String    @map("section_id") @db.Uuid
  status           String    @default("LOCKED") @db.VarChar(20) // LOCKED, IN_PROGRESS, COMPLETED, SKIPPED
  startedAt        DateTime? @map("started_at")
  endedAt          DateTime? @map("ended_at")
  timeSpentSeconds Int       @default(0) @map("time_spent_seconds")

  // Relations
  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([sectionId])
  @@map("academy_exam_attempt_section_states")
}

model ExamAttemptDetail {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  examQuestionId   String   @map("exam_question_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  userAnswer       Json?    @map("user_answer") @db.JsonB
  isCorrect        Boolean? @map("is_correct")
  pointsEarned     Decimal? @map("points_earned") @db.Decimal(7, 2)
  timeSpentSeconds Int?     @map("time_spent_seconds")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  attempt      ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestion ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([examQuestionId])
  @@index([questionId])
  @@map("academy_exam_attempt_details")
}

model AssignmentSubmission {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId              String           @map("class_id") @db.Uuid
  classAssessmentId    String           @map("class_assessment_id") @db.Uuid
  assignmentTemplateId String           @map("assignment_template_id") @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  status               SubmissionStatus @default(DRAFT)
  score                Decimal?         @db.Decimal(7, 2)
  submittedAt          DateTime?        @map("submitted_at")
  gradedAt             DateTime?        @map("graded_at")
  content              Json?            @db.JsonB
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at")

  // Relations
  class              Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  classAssessment    ClassAssessment    @relation(fields: [classAssessmentId], references: [id], onDelete: Cascade)
  assignmentTemplate AssignmentTemplate @relation(fields: [assignmentTemplateId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([classAssessmentId])
  @@index([assignmentTemplateId])
  @@index([userId])
  @@map("academy_assignment_submissions")
}

// --- Commerce layer (academy offerings) ---

model CourseOffering {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String         @unique @db.VarChar(150)
  title         String         @db.VarChar(255)
  description   String?        @db.Text
  originalPrice Decimal        @map("original_price") @db.Decimal(12, 2)
  currency      String         @default("VND") @db.VarChar(10)
  status        OfferingStatus @default(DRAFT)
  type          OrderType      @default(COURSE)
  validFrom     DateTime?      @map("valid_from")
  validTo       DateTime?      @map("valid_to")
  metadata      Json?          @default("{}") @db.JsonB
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")

  // Relations
  classes    CourseOfferingClass[]
  orderItems OrderItem[]

  @@index([status])
  @@map("academy_course_offerings")
}

model CourseOfferingClass {
  offeringId String  @map("offering_id") @db.Uuid
  classId    String  @map("class_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")

  // Relations
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  class    Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([offeringId, classId])
  @@index([classId])
  @@map("academy_course_offering_classes")
}
