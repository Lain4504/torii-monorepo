// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CourseStatus {
  draft
  pending_review
  published
  rejected
  archived
}

model Course {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String       @db.VarChar(255)
  slug             String       @unique @db.VarChar(255)
  type             String       @default("vod") @db.VarChar(20) // 'vod' | 'live'
  description      String?      @db.Text
  shortDescription String?      @map("short_description") @db.VarChar(500)
  jlptLevel        String       @map("jlpt_level") @db.VarChar(5)
  aiMetadata       Json?        @default("{}") @map("ai_metadata")
  thumbnailUrl     String?      @map("thumbnail_url") @db.Text
  previewVideoUrl  String?      @map("preview_video_url") @db.Text
  price            Decimal      @default(0.00) @db.Decimal(10, 2)
  discountPrice    Decimal?     @map("discount_price") @db.Decimal(10, 2)
  liveConfig       Json?        @map("live_config")
  durationWeeks    Int?         @map("duration_weeks")
  totalLessons     Int          @default(0) @map("total_lessons")
  totalQuizzes     Int          @default(0) @map("total_quizzes")
  totalStudents    Int          @default(0) @map("total_students")
  averageRating    Decimal      @default(0.00) @map("average_rating") @db.Decimal(3, 2)
  totalReviews     Int          @default(0) @map("total_reviews")
  status           CourseStatus @default(draft)
  rejectionReason  String?      @map("rejection_reason") @db.Text
  isFree           Boolean      @default(false) @map("is_free")
  tags             String[]     @default([]) @db.VarChar(50)
  learningOutcomes Json         @default("[]") @map("learning_outcomes")
  requirements     Json         @default("[]")
  createdBy        String?      @map("created_by") @db.Uuid
  approvedBy       String?      @map("approved_by") @db.Uuid
  approvedAt       DateTime?    @map("approved_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  // Relations
  modules      Module[]
  wishlists    Wishlist[]
  reviews      Review[]
  quizzes      Quiz[]
  instructors  CourseInstructor[]
  liveSessions LiveSession[]
  enrollments  Enrollment[]
  assignments  Assignment[]
  certificates Certificate[]

  @@index([jlptLevel])
  @@index([createdBy])
  @@index([approvedBy])
  @@map("courses")
}

// Modules: chapters/sections that belong to a Course
model Module {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  title           String    @db.VarChar(255)
  description     String?   @db.Text
  aiMetadata      Json?     @default("{}") @map("ai_metadata")
  status          String    @default("published") @db.VarChar(20) // published, draft
  orderIndex      Int       @default(0) @map("order_index")
  durationMinutes Int?      @map("duration_minutes")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  assignments Assignment[]

  @@index([courseId])
  @@map("modules")
}

// Lessons: individual content items that belong to Modules
model Lesson {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId       String    @map("module_id") @db.Uuid
  title          String    @db.VarChar(255)
  contentType    String    @map("content_type") @db.VarChar(20)
  videoUrl       String?   @map("video_url") @db.Text
  videoDuration  Int?      @map("video_duration")
  articleContent String?   @map("article_content") @db.Text
  aiMetadata     Json?     @default("{}") @map("ai_metadata")
  status         String    @default("published") @db.VarChar(20) // published, draft
  orderIndex     Int       @default(0) @map("order_index")
  isPreview      Boolean   @default(false) @map("is_preview")
  isUnlocked     Boolean   @default(true) @map("is_unlocked")
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizzes        Quiz[]
  materials      LessonMaterial[]
  lessonProgress LessonProgress[]
  assignments    Assignment[]

  @@index([moduleId])
  @@map("lessons")
}

// Lesson Progress - Tracks progress for each lesson within an enrollment
model LessonProgress {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId    String    @map("enrollment_id") @db.Uuid
  lessonId        String    @map("lesson_id") @db.Uuid
  status          String    @default("not_started") @db.VarChar(20) // not_started, in_progress, completed
  watchedDuration Int       @default(0) @map("watched_duration")
  totalDuration   Int       @map("total_duration")
  lastWatchedAt   DateTime  @default(now()) @map("last_watched_at")
  completedAt     DateTime? @map("completed_at")
  notes           String?   @db.Text

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ============================================
// ASSIGNMENTS & SUBMISSIONS
// ============================================

// Assignment Types
enum AssignmentType {
  TEXT // Text answer only
  FILE // File upload only  
  BOTH // Text + File
}

// Assignment - Bài tập do giảng viên tạo
model Assignment {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String         @db.VarChar(255)
  description     String         @db.Text
  type            AssignmentType @default(TEXT)

  // Associated with (at least one required)
  courseId String? @map("course_id") @db.Uuid
  moduleId String? @map("module_id") @db.Uuid
  lessonId String? @map("lesson_id") @db.Uuid

  // Grading config
  maxScore     Decimal @default(100.00) @map("max_score") @db.Decimal(5, 2)
  passingScore Decimal? @map("passing_score") @db.Decimal(5, 2)

  // Deadlines
  dueDate             DateTime? @map("due_date")
  allowLateSubmission Boolean   @default(true) @map("allow_late_submission")
  latePenaltyPercent  Decimal?  @map("late_penalty_percent") @db.Decimal(5, 2) // Optional reference, không auto-apply

  // File upload config
  allowedFileTypes String[] @default([]) @map("allowed_file_types") @db.VarChar(20) // ["pdf", "docx", "png"]
  maxFileSize      Int?     @default(52428800) @map("max_file_size") // bytes (default 50MB)
  maxFiles         Int?     @default(5) @map("max_files")

  // Metadata
  instructions   String?  @db.Text
  attachmentUrls String[] @default([]) @map("attachment_urls") @db.Text
  createdBy      String   @map("created_by") @db.Uuid
  status         AssignmentStatus @default(DRAFT)
  publishedAt    DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      Module?      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([courseId])
  @@index([moduleId])
  @@index([lessonId])
  @@index([status])
  @@index([dueDate])
  @@index([createdBy])
  @@map("assignments")
}

// Assignment Status
enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

// Submission Status
enum SubmissionStatus {
  DRAFT     // Đang soạn (chưa nộp)
  SUBMITTED // Đã nộp
  GRADED    // Đã chấm
  RETURNED  // Trả lại để sửa
}

// Submission - Bài nộp của học viên
model Submission {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid

  // Submission content
  textAnswer String?  @map("text_answer") @db.Text
  fileUrls   String[] @default([]) @map("file_urls") @db.Text

  // Status tracking
  status      SubmissionStatus @default(DRAFT)
  submittedAt DateTime?        @map("submitted_at")
  isLate      Boolean          @default(false) @map("is_late")
  daysLate    Int?             @default(0) @map("days_late") // For BR-04: penalty calculation

  // Grading
  score    Decimal?  @db.Decimal(5, 2)
  feedback String?   @db.Text
  gradedBy String?   @map("graded_by") @db.Uuid
  gradedAt DateTime? @map("graded_at")

  // History tracking
  attemptNumber        Int     @default(1) @map("attempt_number")
  previousSubmissionId String? @map("previous_submission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId, attemptNumber])
  @@index([assignmentId])
  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@index([gradedBy])
  @@map("submissions")
}

// ============================================
// COURSE INSTRUCTOR
// ============================================


enum InstructorRole {
  MAIN
  ASSISTANT
  RECORDER
}

// Course Instructor - Junction table linking courses to lecturers
model CourseInstructor {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId     String         @map("course_id") @db.Uuid
  lecturerId   String         @map("lecturer_id") @db.Uuid
  role         InstructorRole @default(MAIN)
  isPrimary    Boolean        @default(false) @map("is_primary")
  assignedDate DateTime       @default(now()) @map("assigned_date")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, lecturerId])
  @@index([courseId])
  @@index([lecturerId])
  @@map("course_instructors")
}

// Live Session - Scheduled live classes for a course
model LiveSession {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  lecturerId  String?  @map("lecturer_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  scheduledAt DateTime @map("scheduled_at")
  duration    Int      @default(90) // minutes
  status      String   @default("scheduled") // scheduled, live, ended, cancelled
  meetingId   String?  @map("meeting_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([lecturerId])
  @@map("live_sessions")
}

// Lesson Material - Junction table linking lessons to file assets for teaching materials
model LessonMaterial {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  fileAssetId String   @map("file_asset_id") @db.Uuid
  type        String   @db.VarChar(50) // 'slides' | 'video' | 'reading' | 'assignment'
  title       String?  @db.VarChar(255)
  orderIndex  Int      @default(0) @map("order_index")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([lessonId, fileAssetId])
  @@index([lessonId])
  @@index([fileAssetId])
  @@map("lesson_materials")
}

model RoomInfo {
  id                 Int    @id @default(autoincrement())
  roomTitle          String @default("") @map("room_title") @db.VarChar(255)
  roomId             String @map("room_id") @db.VarChar(64)
  sid                String @unique @map("sid") @db.VarChar(64)
  joinedParticipants Int    @default(0) @map("joined_participants")

  // Int, 1 for true 2 for false
  isRunning    Int    @default(0) @map("is_running")
  isRecording  Int    @default(0) @map("is_recording")
  recorderId   String @default("") @map("recorder_id") @db.VarChar(36)
  isActiveRtmp Int    @default(0) @map("is_active_rtmp")
  rtmpNodeId   String @default("") @map("rtmp_node_id") @db.VarChar(36)
  webhookUrl   String @default("") @map("webhook_url") @db.VarChar(255)

  isBreakoutRoom Int       @default(0) @map("is_breakout_room")
  parentRoomId   String    @default("") @map("parent_room_id") @db.VarChar(64)
  creationTime   Int       @default(0) @map("creation_time")
  created        DateTime  @default(now()) @map("created")
  ended          DateTime? @map("ended") // Nullable - null means not ended yet (PostgreSQL compatible)
  modified       DateTime  @default(now()) @updatedAt @map("modified")

  // Relations

  artifacts RoomArtifact[]

  @@index([roomId, isRunning], map: "idx_room_id")
  @@map("room_info")
}

model RoomFile {
  id        Int      @id @default(autoincrement())
  fileId    String   @unique @map("file_id")
  roomId    String   @map("room_id")
  userId    String   @map("user_id")
  filePath  String   @map("file_path")
  fileType  String   @map("file_type")
  mimeType  String   @map("mime_type")
  fileSize  Float    @default(0) @map("file_size")
  createdAt DateTime @default(now()) @map("created")

  @@index([roomId])
  @@map("room_files")
}


model RoomArtifact {
  id          BigInt   @id @default(autoincrement())
  artifactId  String   @unique @map("artifact_id") @db.VarChar(64)
  roomTableId Int      @map("room_table_id")
  roomId      String   @map("room_id") @db.VarChar(255)
  type        String   @db.VarChar(100)
  metadata    Json?
  created     DateTime @default(now())

  // Relation to RoomInfo
  roomInfo RoomInfo @relation(fields: [roomTableId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([artifactId], map: "idx_artifact_artifact_id")
  @@index([roomId], map: "idx_artifact_room_id")
  @@index([type], map: "idx_artifact_type")
  @@map("room_artifacts")
}

// ============================================
// RBAC Models (Editable via Admin UI)
// ============================================

model RolePermission {
  roleCode       String   @map("role_code") @db.VarChar(50)
  permissionCode String   @map("permission_code") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@id([roleCode, permissionCode])
  @@index([roleCode])
  @@map("role_permissions")
}

// ============================================
// Audit Log (Generic System-Wide Logging)
// ============================================

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Who performed the action
  userId    String @map("user_id") @db.Uuid

  // What action was performed
  action   String  @db.VarChar(100) // e.g., "permission.grant", "user.create", "course.delete"
  entity   String  @db.VarChar(100) // e.g., "role_permission", "user", "course"
  entityId String? @map("entity_id") @db.VarChar(255) // ID of affected entity

  // Action details
  description String @db.Text // Human-readable description
  metadata    Json? // Flexible JSON for action-specific data

  // State changes (for updates)
  oldValues Json? @map("old_values") // Previous state
  newValues Json? @map("new_values") // New state

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()

  // Relations
  user User @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// User Model
// ============================================

model User {
  id          String @id @default(uuid()) @db.Uuid
  email       String @unique @db.VarChar(255)
  displayName String @map("display_name") @db.VarChar(100)

  // Auth fields
  password String? @db.VarChar(255) // Nullable for OAuth-only users

  // Profile fields
  avatarUrl String? @map("avatar_url") @db.Text

  // Metadata (JSON for flexibility)
  appMetadata  Json? @default("{}") @map("app_metadata") // App-specific data (providers, etc.)
  userMetadata Json? @default("{}") @map("user_metadata") // User profile data from OAuth

  // Role
  role String @default("learner") @db.VarChar(50)

  // Timestamps (replace status field - Supabase pattern)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamp() // null = not verified (pending)
  bannedUntil  DateTime? @map("banned_until") @db.Timestamp() // null = not banned, value = banned until this time
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamp()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp() // null = not deleted, value = soft deleted

  // Relations
  identities              UserIdentity[] // OAuth providers (email, google, etc.)
  sessions                Session[]
  twoFactorAuth           TwoFactorAuth?
  flashcardDecks          FlashcardDeck[]
  flashcardUserProgress   FlashcardUserProgress[] // Per-user flashcard progress
  flashcardReviews        FlashcardReview[] // Flashcard review history
  flashcardReviewSessions FlashcardReviewSession[] // Review sessions
  comments                Comment[]
  auditLogs               AuditLog[]               @relation("UserAuditLogs")
  wishlists               Wishlist[]
  reviews                 Review[]
  enrollments             Enrollment[]
  orders                  Order[]
  payments                Payment[]
  giftEnrollments         Enrollment[]             @relation("GiftEnrollments")
  certificates            Certificate[]

  // Gamification Relations
  gamification    UserGamification?
  dailyActivities DailyActivity[]
  achievements    UserAchievement[]

  // Coupon Relations
  createdCoupons  Coupon[]         @relation("CouponCreator")

  // QA Relations
  qas             QA[]
  qaLikes         QAUserLike[]
  commentLikes    CommentLike[]

  // Ticket Relations
  tickets         Ticket[]         @relation("UserTickets")
  handledTickets  Ticket[]         @relation("HandlerTickets")

  @@index([email])
  @@index([role])
  @@map("users")
}



// User Identity Model - For OAuth providers (email, google, etc.)
model UserIdentity {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Provider info
  provider   String @db.VarChar(50) // 'email', 'google', etc.
  providerId String @map("provider_id") @db.VarChar(255) // Provider's user ID

  // Provider metadata
  providerData Json? @map("provider_data") // Raw data from provider

  // Timestamps
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamp()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId]) // Prevent duplicate provider accounts
  @@index([userId])
  @@index([provider])
  @@map("user_identities")
}

// Session Model - For managing user sessions and refresh tokens
model Session {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64) // SHA-256 hash

  // Device & Metadata
  deviceInfo String? @map("device_info") @db.VarChar(100) // e.g., "iPhone 13, iOS 15" or "Chrome on Windows"

  expiresAt DateTime  @map("expires_at") @db.Timestamp()
  revokedAt DateTime? @map("revoked_at") @db.Timestamp()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

// Two-Factor Authentication Model - For 2FA configuration
model TwoFactorAuth {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // 2FA Status
  isEnabled Boolean @default(false) @map("is_enabled")
  method    String? @db.VarChar(20) // Currently only 'totp' supported (Google Authenticator)

  // TOTP Configuration (for Google Authenticator)
  totpSecret      String?  @map("totp_secret") @db.VarChar(255) // Encrypted with AES-256-GCM
  totpBackupCodes String[] @default([]) @map("totp_backup_codes") @db.VarChar(100) // Hashed with Argon2

  // Security & Metadata
  enabledAt      DateTime? @map("enabled_at") @db.Timestamp()
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamp()
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamp()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_auth")
}

// ============================================
// FLASHCARD ENUMS - Anki-like SRS System
// ============================================

enum FlashcardState {
  new
  learning
  review
  relearning
}

enum FlashcardGenerationMethod {
  manual
  ai_auto
  ai_assisted
  import
}

enum JapanesePartOfSpeech {
  noun
  verb_ichidan
  verb_godan
  verb_suru
  verb_kuru
  adjective_i
  adjective_na
  adverb
  particle
  conjunction
  interjection
  pronoun
  number
  other
}

enum ReviewQuality {
  ZERO // Again (incorrect)
  ONE // Hard
  TWO // Good
  THREE // Easy
  FOUR // Easy+
}

// ============================================
// FLASHCARD MODELS
// ============================================

// Improved Flashcard Deck với SRS settings và AI integration
model FlashcardDeck {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  jlptLevel    String?  @map("jlpt_level") @db.VarChar(5)
  isPublic     Boolean  @default(false) @map("is_public")
  tags         String[] @default([]) @db.VarChar(50)
  cardCount    Int      @default(0) @map("card_count")
  studiedCount Int      @default(0) @map("studied_count")

  // SRS Settings (Anki-like)
  srsSettings Json? @default("{\"newCardsPerDay\":20,\"maxReviewsPerDay\":200,\"easyBonus\":1.3,\"intervalModifier\":1.0,\"maximumInterval\":36500}") @map("srs_settings")

  // AI Integration Settings
  aiSettings Json?   @default("{\"autoGenerate\":false,\"requireApproval\":true,\"minConfidence\":0.8,\"filters\":[]}") @map("ai_settings")
  sourceType String? @default("manual") @map("source_type") @db.VarChar(20)

  // Activity Tracking
  lastStudiedAt     DateTime? @map("last_studied_at")
  totalStudyTime    Int       @default(0) @map("total_study_time") // seconds
  masteryPercentage Decimal?  @map("mastery_percentage") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards     Flashcard[]
  reviews        FlashcardReview[]
  reviewSessions FlashcardReviewSession[]

  @@index([userId])
  @@map("flashcard_decks")
}

// Improved Flashcard với Japanese fields và AI metadata
model Flashcard {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deckId          String   @map("deck_id") @db.Uuid
  frontText       String   @map("front_text") @db.Text
  backText        String   @map("back_text") @db.Text
  exampleSentence String?  @map("example_sentence") @db.Text
  pronunciation   String?  @db.Text
  imageUrl        String?  @map("image_url") @db.Text
  audioUrl        String?  @map("audio_url") @db.Text
  tags            String[] @default([]) @db.VarChar(50)
  difficulty      String   @default("medium") @db.VarChar(20)

  // Japanese-specific fields
  furigana      String?               @db.Text
  kanji         String?               @db.Text
  partOfSpeech  JapanesePartOfSpeech? @map("part_of_speech")
  wordJlptLevel String?               @map("word_jlpt_level") @db.VarChar(5)
  meanings      Json?                 @default("[]") // Structured meanings with examples

  // AI Integration fields
  aiGenerated        Boolean                   @default(false) @map("ai_generated")
  sourceDocumentId   String?                   @map("source_document_id") @db.Uuid
  generationMethod   FlashcardGenerationMethod @default(manual) @map("generation_method")
  generationMetadata Json?                     @default("{}") @map("generation_metadata")

  // SRS fields (global - for compatibility)
  nextReviewDate DateTime? @map("next_review_date") @db.Date
  intervalDays   Int       @default(1) @map("interval_days")
  easeFactor     Decimal   @default(2.50) @map("ease_factor") @db.Decimal(4, 2)
  reviewCount    Int       @default(0) @map("review_count")
  correctCount   Int       @default(0) @map("correct_count")
  lastReviewDate DateTime? @map("last_review_date") @db.Date
  timesStudied   Int       @default(0) @map("times_studied")

  // Metadata
  notes      String? @db.Text
  isArchived Boolean @default(false) @map("is_archived")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  deck           FlashcardDeck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  sourceDocument FileAsset?              @relation("FlashcardSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  userProgress   FlashcardUserProgress[]
  reviews        FlashcardReview[]

  @@index([deckId])
  @@index([nextReviewDate])
  @@index([aiGenerated])
  @@index([wordJlptLevel])
  @@index([sourceDocumentId])
  @@map("flashcards")
}

// Per-user progress tracking (CRITICAL for SRS)
model FlashcardUserProgress {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  flashcardId String @map("flashcard_id") @db.Uuid

  // Card State (Anki-like)
  state FlashcardState @default(new)

  // SRS Algorithm fields (per-user)
  currentInterval Int       @default(0) @map("current_interval") // Days until next review
  easeFactor      Decimal   @default(2.50) @map("ease_factor") @db.Decimal(4, 2)
  lastReviewedAt  DateTime? @map("last_reviewed_at")
  nextReviewDate  DateTime? @map("next_review_date") @db.Date

  // Review statistics (per-user)
  timesReviewed      Int @default(0) @map("times_reviewed")
  timesCorrect       Int @default(0) @map("times_correct")
  timesIncorrect     Int @default(0) @map("times_incorrect")
  consecutiveCorrect Int @default(0) @map("consecutive_correct")

  // Daily limits
  reviewedToday  Int       @default(0) @map("reviewed_today")
  lastReviewDate DateTime? @map("last_review_date") @db.Date

  // Performance metrics
  averageResponseTime Int  @default(0) @map("average_response_time")
  lastResponseTime    Int? @map("last_response_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId])
  @@index([flashcardId])
  @@index([userId, nextReviewDate])
  @@index([userId, state])
  @@map("flashcard_user_progress")
}

// Review history tracking
model FlashcardReview {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  flashcardId String  @map("flashcard_id") @db.Uuid
  sessionId   String? @map("session_id") @db.Uuid
  deckId      String  @map("deck_id") @db.Uuid

  // Review result
  quality   ReviewQuality // 0=Again, 1=Hard, 2=Good, 3-4=Easy
  timeSpent Int           @default(0) @map("time_spent") // milliseconds

  // SRS calculation (before review)
  previousInterval   Int?            @map("previous_interval")
  previousEaseFactor Decimal?        @map("previous_ease_factor") @db.Decimal(4, 2)
  previousState      FlashcardState? @map("previous_state")

  // SRS calculation (after review)
  newInterval       Int?            @map("new_interval")
  newEaseFactor     Decimal?        @map("new_ease_factor") @db.Decimal(4, 2)
  newState          FlashcardState? @map("new_state")
  newNextReviewDate DateTime?       @map("new_next_review_date") @db.Date

  // Review metadata
  reviewDate DateTime @default(now()) @map("review_date")
  userAnswer String?  @map("user_answer") @db.Text

  // Analytics
  deviceType     String? @map("device_type") @db.VarChar(50)
  reviewDuration Int?    @map("review_duration")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard               @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  deck      FlashcardDeck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  session   FlashcardReviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([flashcardId])
  @@index([sessionId])
  @@index([deckId])
  @@index([reviewDate])
  @@map("flashcard_reviews")
}

// Review session tracking
model FlashcardReviewSession {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  deckId String @map("deck_id") @db.Uuid

  // Session tracking
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  durationSeconds Int       @default(0) @map("duration_seconds")

  // Statistics
  totalCards    Int @default(0) @map("total_cards")
  newCards      Int @default(0) @map("new_cards")
  learningCards Int @default(0) @map("learning_cards")
  reviewCards   Int @default(0) @map("review_cards")

  correctCount   Int @default(0) @map("correct_count")
  incorrectCount Int @default(0) @map("incorrect_count")
  hardCount      Int @default(0) @map("hard_count")
  easyCount      Int @default(0) @map("easy_count")

  // Performance
  averageResponseTime Int      @default(0) @map("average_response_time")
  masteryScore        Decimal? @map("mastery_score") @db.Decimal(5, 2)

  // Metadata
  deviceType String? @map("device_type") @db.VarChar(50)
  studyMode  String? @map("study_mode") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck    FlashcardDeck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews FlashcardReview[]

  @@index([userId])
  @@index([deckId])
  @@index([startedAt])
  @@map("flashcard_review_sessions")
}

// File Assets - Source of Truth for all files in the system
model FileAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // File Identification
  fileUrl String @unique @map("file_url") @db.Text

  // File Details
  mimeType String? @map("mime_type") @db.VarChar(100)
  fileSize BigInt? @map("file_size")
  isPublic Boolean @default(false) @map("is_public")

  // Upload Status: 'pending' | 'uploaded' | 'failed'
  status String @default("pending") @db.VarChar(20)

  // Flexible Metadata (JSONB)
  metadata     Json?   @default("{}") @map("metadata")
  ownerId      String? @map("owner_id") @db.Uuid
  moduleOrigin String? @map("module_origin") @db.VarChar(50) // 'USER', 'COURSE', 'CHAT'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

