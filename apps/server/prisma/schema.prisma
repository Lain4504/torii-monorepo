  classId         String   @map("class_id") @db.Uuid
  enrollmentId    String   @unique @map("enrollment_id") @db.Uuid
  certificateCode String   @unique @map("certificate_code") @db.VarChar(50)
  issueDate       DateTime @default(now()) @map("issue_date")
  fileUrl         String   @map("file_url") @db.Text
  metadata        Json?    @default("{}")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([classId])
  @@map("certificates")
}

// --- Notes ---



// ==================================================
// 12. ACADEMY CORE LMS V2 (Strictly Typed — No JSON Metadata)
// ==================================================

// Syllabus status


// Course Profile status
enum CourseProfileStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

// LIVE term status (cohort/term grouping)
enum LiveTermStatus {
  DRAFT
  OPENING
  ONGOING
  COMPLETED
  ARCHIVED
}

// Lesson content type
enum LessonType {
  VIDEO
  READING
}

// ==================================================
// CONTENT BANK LAYER
// ==================================================

model CourseProfile {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String              @unique @db.VarChar(100)
  title        String              @db.VarChar(255)
  description  String?             @db.Text
  level        String?             @db.VarChar(50) // N5, N4, N3, N2, N1
  thumbnailUrl String?             @map("thumbnail_url") @db.Text
  status       CourseProfileStatus @default(DRAFT)

  // Approval workflow
  submittedForApprovalAt DateTime? @map("submitted_for_approval_at")
  submittedBy            String?   @map("submitted_by") @db.Uuid
  approvedAt             DateTime? @map("approved_at")
  approvedBy             String?   @map("approved_by") @db.Uuid

  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at")

  modules       Module[]
  classes       Class[]
  liveTerms     LiveTerm[]

  @@index([level])
  @@map("academy_course_profiles")
}

model LiveTerm {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId String         @map("course_profile_id") @db.Uuid

  // Human-readable term identifier, e.g. "N5-2026Q2"
  termCode String @map("term_code") @db.VarChar(50)

  status LiveTermStatus @default(DRAFT)

  // Term timeline (operational)
  openingDate       DateTime? @map("opening_date")
  closingDate       DateTime? @map("closing_date")
  enrollmentOpenAt  DateTime? @map("enrollment_open_at")
  enrollmentCloseAt DateTime? @map("enrollment_close_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  courseProfile CourseProfile @relation(fields: [courseProfileId], references: [id], onDelete: Cascade)
  classes       Class[]

  @@unique([courseProfileId, termCode])
  @@index([courseProfileId])
  @@index([status])
  @@map("academy_live_terms")
}

// Syllabus has been removed to simplify the hierarchy as per Product-Centric refactor.
// Modules now link directly to CourseProfile.
/// Module (chương/bài) là folder chứa các bài học thực tế
model Module {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId String @map("course_profile_id") @db.Uuid
  title           String @db.VarChar(255)
  orderIndex      Int    @map("order_index")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  courseProfile CourseProfile @relation(fields: [courseProfileId], references: [id], onDelete: Cascade)
  lessons       Lesson[]

  @@unique([courseProfileId, orderIndex])
  @@index([courseProfileId])
  @@map("academy_modules")
}

/// Lesson là đơn vị nội dung thực tế (VIDEO hoặc READING)
model Lesson {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId   String     @map("module_id") @db.Uuid
  type       LessonType
  title      String     @db.VarChar(255)
  orderIndex Int        @map("order_index")
  videoUrl   String?    @map("video_url") @db.Text // Only for VIDEO type
  /// Nội dung bài học dạng rich text (markdown) từ admin
  content    String?    @db.Text
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at")

  module     Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress   UserLessonProgress[]
  studyNotes StudyNote[]

  @@unique([moduleId, orderIndex])
  @@index([moduleId])
  @@map("academy_lessons")
}

/// Assignment là nội dung bài tập tự luận (Sakubun, Kaiwa) — Master/Content Bank
model Assignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String   @db.VarChar(255)
  instructions String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  classAssignments ClassAssignment[]

  @@map("academy_assignments")
}

// ==================================================
// DELIVERY LAYER
// ==================================================

model Class {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseProfileId String      @map("course_profile_id") @db.Uuid
  termId          String?     @map("term_id") @db.Uuid
  code            String      @unique @db.VarChar(50)
  name            String      @db.VarChar(150)
  mode            ClassMode   @default(LIVE)
  status          ClassStatus @default(DRAFT)
  instructorId    String?     @map("instructor_id") @db.Uuid

  // Approval workflow
  submittedForApprovalAt DateTime? @map("submitted_for_approval_at")
  submittedBy            String?   @map("submitted_by") @db.Uuid
  approvedAt             DateTime? @map("approved_at")
  approvedBy             String?   @map("approved_by") @db.Uuid
  rejectedAt             DateTime? @map("rejected_at")
  rejectedBy             String?   @map("rejected_by") @db.Uuid
  rejectionReason        String?   @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  courseProfile CourseProfile @relation(fields: [courseProfileId], references: [id], onDelete: Cascade)
  term          LiveTerm?     @relation(fields: [termId], references: [id], onDelete: SetNull)
  instructor    User?         @relation("AcademyClassTeacher", fields: [instructorId], references: [id], onDelete: SetNull)
  enrollments          Enrollment[]
  classAssignments     ClassAssignment[]
  userLessonProgress   UserLessonProgress[]
  tickets              Ticket[]
  certificates         Certificate[]
  offering             CourseOffering?
  reviews              ClassReview[]
  liveSchedules        LiveSchedule[]
  liveScheduleSessions LiveScheduleSession[]

  @@index([courseProfileId])
  @@index([termId])
  @@index([mode])
  @@index([status])
  @@map("classroom_classes")
}

/// ClassAssignment: Bài tập được giao riêng cho lớp LIVE (tách khỏi Syllabus)
model ClassAssignment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId       String    @map("class_id") @db.Uuid
  assignmentId  String    @map("assignment_id") @db.Uuid
  titleOverride String?   @map("title_override") @db.VarChar(255) // Override tên bài tập cho lớp này
  openAt        DateTime? @map("open_at")
  deadline      DateTime?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignment  Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@unique([classId, assignmentId]) // Mỗi assignment chỉ gán 1 lần vào 1 lớp
  @@index([classId])
  @@map("academy_class_assignments")
}

/// UserLessonProgress: Tiến độ học bài của từng học viên trong một lớp cụ thể
model UserLessonProgress {
  userId        String    @map("user_id") @db.Uuid
  classId       String    @map("class_id") @db.Uuid
  lessonId      String    @map("lesson_id") @db.Uuid
  isCompleted   Boolean   @default(false) @map("is_completed")
  lastWatchedAt DateTime? @map("last_watched_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  user   User   @relation("AcademyUserLessonProgress", fields: [userId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, classId, lessonId])
  @@index([classId])
  @@index([userId])
  @@map("academy_user_lesson_progress")
}

/// AssignmentSubmission: Bài nộp của học viên (Single Submission Policy)
model AssignmentSubmission {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classAssignmentId String           @map("class_assignment_id") @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  status            SubmissionStatus @default(SUBMITTED)
  grade             Decimal?         @db.Decimal(5, 2)
  feedback          String?          @db.Text
  content           String?          @db.Text // Text answer
  fileUrls          String[]         @map("file_urls") // File upload URLs
  submittedAt       DateTime?        @default(now()) @map("submitted_at")
  gradedAt          DateTime?        @map("graded_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at")

  classAssignment ClassAssignment @relation(fields: [classAssignmentId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, classAssignmentId]) // Single Submission Policy
  @@index([classAssignmentId])
  @@index([userId])
  @@map("academy_assignment_submissions")
}

// ==================================================
// LIVE CLASS SCHEDULE LAYER (Giữ nguyên)
// ==================================================

model LiveSchedule {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId       String  @map("class_id") @db.Uuid
  weekday       Int // 0-6
  startTime     String  @map("start_time") @db.VarChar(20)
  endTime       String  @map("end_time") @db.VarChar(20)
  location      String? @db.VarChar(255)
  excludedDates Json?   @map("excluded_dates") @db.JsonB
  note          String? @db.Text
  roomId        String? @map("room_id") @db.VarChar(64)

  class    Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessions LiveScheduleSession[]

  @@index([classId])
  @@map("academy_live_schedules")
}

/// Live session instance theo ngày cho từng buổi học cụ thể
model LiveScheduleSession {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId    String  @map("class_id") @db.Uuid
  scheduleId String? @map("schedule_id") @db.Uuid

  /// Ngày diễn ra buổi học (theo timezone vận hành, lưu ở UTC)
  sessionDate DateTime @map("session_date")

  /// Giờ bắt đầu/kết thúc (HH:mm, text)
  startTime String @map("start_time") @db.VarChar(20)
  endTime   String @map("end_time") @db.VarChar(20)

  status String @default("SCHEDULED") @db.VarChar(20) // SCHEDULED, CANCELLED, RESCHEDULED, COMPLETED

  cancellationReason String? @map("cancellation_reason") @db.Text

  roomId       String? @map("room_id") @db.VarChar(64)
  location     String? @db.VarChar(255)
  note         String? @db.Text
  instructorId String? @map("instructor_id") @db.Uuid

  supersededBySessionId String? @map("superseded_by_session_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  // Relations
  class    Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  schedule LiveSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  supersededBySession LiveScheduleSession?  @relation("LiveScheduleSessionSupersede", fields: [supersededBySessionId], references: [id])
  supersededSessions  LiveScheduleSession[] @relation("LiveScheduleSessionSupersede")
  requests            LiveScheduleRequest[]
  attendances         ClassAttendance[]

  @@index([classId, sessionDate])
  @@index([scheduleId])
  @@index([status])
  @@unique([classId, sessionDate, startTime, endTime])
  @@map("academy_live_schedule_sessions")
}

model LiveScheduleRequest {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String                    @map("session_id") @db.Uuid
  classId           String?                   @map("class_id") @db.Uuid
  requestedBy       String                    @map("requested_by") @db.Uuid
  type              LiveScheduleRequestType
  status            LiveScheduleRequestStatus @default(PENDING)
  reason            String?                   @db.Text
  requestedDate     DateTime?                 @map("requested_date")
  originalWeekday   Int                       @map("original_weekday")
  originalStartTime String                    @map("original_start_time") @db.VarChar(20)
  originalEndTime   String                    @map("original_end_time") @db.VarChar(20)
  proposedDate      DateTime?                 @map("proposed_date")
  proposedStartTime String?                   @map("proposed_start_time") @db.VarChar(20)
  proposedEndTime   String?                   @map("proposed_end_time") @db.VarChar(20)
  proposedTeacherId String?                   @map("proposed_teacher_id") @db.Uuid
  reviewNote        String?                   @map("review_note") @db.Text
  reviewedBy        String?                   @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?                 @map("reviewed_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at")

  session         LiveScheduleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requester       User                @relation("LiveScheduleRequestRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  reviewer        User?               @relation("LiveScheduleRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  proposedTeacher User?               @relation("LiveScheduleRequestProposedTeacher", fields: [proposedTeacherId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([requestedBy])
  @@index([status])
  @@index([requestedDate])
  @@map("academy_live_schedule_requests")
}

// ==================================================
// COMMERCE & ENROLLMENT LAYER
// ==================================================

model CourseOffering {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId     String         @unique @map("class_id") @db.Uuid
  code        String         @unique @db.VarChar(150)
  title       String         @db.VarChar(255)
  description String?        @db.Text
  price       Decimal        @map("price") @db.Decimal(12, 2)
  salePrice   Decimal?       @map("sale_price") @db.Decimal(12, 2)
  currency    String         @default("VND") @db.VarChar(10)
  mode        ClassMode      // VOD or LIVE
  status      OfferingStatus @default(DRAFT)
  type        OrderType      @default(COURSE)
  validFrom   DateTime?      @map("valid_from")
  validTo     DateTime?      @map("valid_to")

  // Approval workflow
  submittedForApprovalAt DateTime? @map("submitted_for_approval_at")
  submittedBy            String?   @map("submitted_by") @db.Uuid
  approvedAt             DateTime? @map("approved_at")
  approvedBy             String?   @map("approved_by") @db.Uuid
  rejectedAt             DateTime? @map("rejected_at")
  rejectedBy             String?   @map("rejected_by") @db.Uuid
  rejectionReason        String?   @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  class      Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  enrollments Enrollment[]

  @@index([status])
  @@map("academy_course_offerings")
}

/// Enrollment: Quyền truy cập của học viên thông qua Class (Trung tâm vận hành)
model Enrollment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  classId       String    @map("class_id") @db.Uuid  // Mọi quyền truy cập phải qua Class (kể cả VOD)
  offeringId    String?   @map("offering_id") @db.Uuid // Truy vết gói đã mua
  enrolledAt    DateTime  @default(now()) @map("enrolled_at")
  expiresAt     DateTime? @map("expires_at")
  status        String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, EXPIRED, CANCELLED
  sourceOrderId String?   @map("source_order_id") @db.Uuid

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  offering    CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  order       Order?          @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  certificate Certificate?
  review      ClassReview?

  @@unique([userId, classId])    // Một người chỉ ở trong một lớp một lần
  @@unique([userId, offeringId]) // Một người chỉ mua một gói một lần (tránh mua trùng)
  @@index([userId])
  @@index([classId])
  @@index([offeringId])
  @@map("academy_enrollments")
}

