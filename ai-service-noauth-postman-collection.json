{
  "info": {
    "name": "Torii AI Learning Support Service - No Auth (Real AI)",
    "description": "Postman collection for testing the AI-Powered Learning Support service with REAL Google Gemini AI (no authentication required). All three agents (Sensei, Assessment, Analytics) now generate authentic AI responses instead of mock data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "torii-ai-service-noauth-real-ai"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Sensei Agent - Language Learning",
      "item": [
        {
          "name": "Grammar Check - Basic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"こんにちは、世界！\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/grammar-check",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai", "grammar-check"]
            },
            "description": "Check Japanese grammar using REAL Google Gemini AI - provides detailed analysis and corrections"
          },
          "response": []
        },
        {
          "name": "Grammar Check - Invalid Grammar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"私は昨日学校に行きましたです。\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/grammar-check",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai", "grammar-check"]
            },
            "description": "Check grammar with intentional errors using REAL AI - demonstrates error detection and correction suggestions"
          },
          "response": []
        },
