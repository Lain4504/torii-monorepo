{
    "system": {
        "version": "1.1.0",
        "description": "RBAC Configuration for Torii Nihongo"
    },
    "roles": [
        {
            "code": "admin",
            "name": "System Administrator",
            "description": "Full access to all system resources",
            "inherits": []
        },
        {
            "code": "staff",
            "name": "Center Staff",
            "description": "Operations staff with flexible permissions (Sales, Academic, Support)",
            "inherits": []
        },
        {
            "code": "lecturer",
            "name": "Instructor",
            "description": "Teaching staff with course and class management capabilities",
            "inherits": []
        },
        {
            "code": "learner",
            "name": "Student",
            "description": "Standard user focusing on learning activities",
            "inherits": []
        }
    ],
    "permissions": [
        {
            "code": "course.view_restricted",
            "description": "View unpublished courses (for review)"
        },
        {
            "code": "course.create",
            "description": "Create new courses"
        },
        {
            "code": "course.update",
            "description": "Update existing courses"
        },
        {
            "code": "course.publish",
            "description": "Approve and publish courses"
        },
        {
            "code": "live_class.schedule",
            "description": "Schedule new live sessions"
        },
        {
            "code": "live_class.manage",
            "description": "Start/End/Update live classes"
        },
        {
            "code": "exam.manage",
            "description": "Create and manage quizzes/exams"
        },
        {
            "code": "submission.grade",
            "description": "Grade student assignments and essays"
        },
        {
            "code": "material.upload",
            "description": "Upload educational resources"
        },
        {
            "code": "user.view",
            "description": "View user lists and profiles"
        },
        {
            "code": "user.manage",
            "description": "Edit user status (ban/approve)"
        },
        {
            "code": "payment.view",
            "description": "View payment history and reports"
        },
        {
            "code": "payment.refund",
            "description": "Process refunds"
        },
        {
            "code": "coupon.manage",
            "description": "Create and manage discounts"
        },
        {
            "code": "blog.write",
            "description": "Write and edit blog posts"
        },
        {
            "code": "report.view",
            "description": "Access analytics and performance reports"
        },
        {
            "code": "system.config",
            "description": "Access system configurations"
        },
        {
            "code": "ai.config",
            "description": "Configure AI agent settings"
        }
    ],
    "default_role_permissions": {
        "admin": [
            "*"
        ],
        "staff": [
            "user.view",
            "course.view_restricted",
            "blog.write",
            "report.view"
        ],
        "lecturer": [
            "live_class.manage",
            "course.update",
            "submission.grade",
            "material.upload"
        ],
        "learner": []
    },
    "staff_templates": {
        "sales_staff": [
            "user.view",
            "payment.view",
            "coupon.manage",
            "report.view"
        ],
        "academic_staff": [
            "course.create",
            "course.update",
            "course.publish",
            "exam.manage",
            "live_class.schedule",
            "submission.grade",
            "material.upload"
        ],
        "support_staff": [
            "user.view",
            "payment.view",
            "report.view"
        ]
    }
}