# ========================================
# Server Configuration
# ========================================
# Gateway server port
PORT=8080

# Environment: development | production | staging
NODE_ENV="development"

# ========================================
# CORS & Security
# ========================================
# Frontend URLs for CORS (comma-separated for multiple origins)
# Development:
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://localhost:5174"
# Production example (uncomment and update with your domains):
# CORS_ORIGIN="https://admin.yourdomain.com,https://learner.yourdomain.com,https://meet.yourdomain.com"

# ========================================
# File Upload (Optional)
# ========================================
# Directory for file uploads
UPLOAD_DIR="./uploads"

# ========================================
# Analytics (Optional)
# ========================================
# Enable/disable analytics
# ENABLE_ANALYTICS="true"

# ========================================
# AWS S3 (Optional - for cloud storage)
# ========================================
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_BUCKET_NAME="your-bucket-name"
R2_ACCOUNT_ID="your-account-id"
R2_PUBLIC_URL="https://your-bucket-name.your-account-id.r2.cloudflarestorage.com"

# ========================================
# wajlc API Security
# ========================================
# Key/secret tự chọn dùng để login vào meet
WAJLC_API_KEY="wajlc"
WAJLC_API_SECRET="zumyyYWqv7KR2kUqvYdq4z4sXg7XTBD2ljT6"
#=======================================
# NATS Subjects (matching config.yaml)
NATS_SUBJECT_SYSTEM_API_WORKER="sysApiWorker"
NATS_SUBJECT_SYSTEM_JS_WORKER="sysJsWorker"
NATS_SUBJECT_SYSTEM_PUBLIC="sysPublic"
NATS_SUBJECT_SYSTEM_PRIVATE="sysPrivate"
NATS_SUBJECT_CHAT="chat"
NATS_SUBJECT_WHITEBOARD="whiteboard"
NATS_SUBJECT_DATA_CHANNEL="dataChannel"
NATS_RECORDER_CHANNEL="recorderChannel"
NATS_RECORDER_INFO_KV="recorderInfo"
NATS_TRANSCODING_JOBS="recorderTranscoderJobs"
NATS_NUM_REPLICAS=1
# ========================================
# Webhook Configuration
# ========================================
WEBHOOK_ENABLED="true"
WEBHOOK_ENABLE_FOR_PER_MEETING="true"
WEBHOOK_URL="http://localhost:8080/webhook"

# ========================================
# JWT Configuration (Deprecated - migrating to Firebase)
# ========================================
# Secret key for signing JWT tokens (use a strong random string in production)
JWT_SECRET=614966cfa2a23e1fa9c23ac0e10b5d146afc1c2d3dfbd6ade002b174cd3b9d18

# Access token expiry (short-lived for security)
JWT_EXPIRES_IN=1d

# Refresh token expiry is hardcoded to 7d in auth service
# This provides a good balance between security and user convenience

# ============================================
# Firebase Configuration
# ============================================
# Firebase Project ID from Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to Firebase Admin SDK service account JSON file
# Download from: Firebase Console > Project Settings > Service Accounts
# Path is relative to monorepo root (torii-monorepo/)
FIREBASE_SERVICE_ACCOUNT_PATH=apps/server/firebase-admin-config.json

# ============================================
# Microservices URLs (for API Gateway)
# ============================================
# Gateway (main entry point)
GATEWAY_PORT=8080

IDENTITY_HTTP_PORT=8081
LMS_HTTP_PORT=8082
FLASHCARDS_HTTP_PORT=8083
COMMUNITY_HTTP_PORT=8084
ASSESSMENT_HTTP_PORT=8085
STORAGE_HTTP_PORT=8086
GAMIFICATION_HTTP_PORT=8088
BILLING_HTTP_PORT=8089
xCORTEX_HTTP_PORT=8090
MEET_HTTP_PORT=8091

# ========================================
# SMTP Configuration (for sending emails)
# ========================================

SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password  # Gmail: Use App Password!
SMTP_FROM="Torii Nihongo <noreply@torii.app>"
FRONTEND_URL=http://localhost:3000