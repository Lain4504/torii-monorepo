# ========================================
# Server Configuration
# ========================================
# Gateway server port
PORT=8080

# Environment: development | production | staging
NODE_ENV="development"

# ========================================
# AWS S3 (Optional - for cloud storage)
# ========================================
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_BUCKET_NAME="your-bucket-name"
R2_ACCOUNT_ID="your-account-id"
R2_PUBLIC_URL="https://your-bucket-name.your-account-id.r2.cloudflarestorage.com"

# ========================================
# wajlc API Security
# ========================================
# Key/secret tự chọn dùng để login vào meet
WAJLC_API_KEY="wajlc"
WAJLC_API_SECRET="zumyyYWqv7KR2kUqvYdq4z4sXg7XTBD2ljT6"
#=======================================
# NATS Subjects (matching config.yaml)
NATS_SUBJECT_SYSTEM_API_WORKER="sysApiWorker"
NATS_SUBJECT_SYSTEM_JS_WORKER="sysJsWorker"
NATS_SUBJECT_SYSTEM_PUBLIC="sysPublic"
NATS_SUBJECT_SYSTEM_PRIVATE="sysPrivate"
NATS_SUBJECT_CHAT="chat"
NATS_SUBJECT_WHITEBOARD="whiteboard"
NATS_SUBJECT_DATA_CHANNEL="dataChannel"
NATS_RECORDER_CHANNEL="recorderChannel"
NATS_RECORDER_INFO_KV="recorderInfo"
NATS_TRANSCODING_JOBS="recorderTranscoderJobs"
NATS_NUM_REPLICAS=1
# ========================================
# Webhook Configuration
# ========================================
WEBHOOK_ENABLED="true"
WEBHOOK_ENABLE_FOR_PER_MEETING="true"
WEBHOOK_URL="http://localhost:8080/webhook"

# ========================================
# JWT Configuration
# ========================================
# Secret key for signing JWT tokens (use a strong random string in production)
JWT_SECRET=614966cfa2a23e1fa9c23ac0e10b5d146afc1c2d3dfbd6ade002b174cd3b9d18

# Access token expiry (short-lived for security)
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh token expiry
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# Microservices Configuration (4 Services)
# ============================================
# Service URLs for Gateway HTTP Proxy
AGENTS_SERVICE_URL=http://localhost:8090
MEET_SERVICE_URL=http://localhost:8091
IDENTITY_SERVICE_URL=http://localhost:8081
LEARNING_SERVICE_URL=http://localhost:8082

# Microservice HTTP Ports
GATEWAY_PORT=8080
IDENTITY_HTTP_PORT=8081
LEARNING_HTTP_PORT=8082
AGENTS_HTTP_PORT=8090
MEET_HTTP_PORT=8091

# ========================================
# SMTP Configuration (for sending emails)
# ========================================

SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password  # Gmail: Use App Password!
SMTP_FROM="Torii Nihongo <noreply@torii.app>"
FRONTEND_URL=http://localhost:3000

# ========================================
# Two-Factor Authentication (2FA)
# ========================================

# Encryption key for TOTP secrets (32 bytes hex = 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=78237bf598b8c7f381fbac43c79053282c45b27311f3e96f25165ac23690a766

# 2FA Settings
TWO_FACTOR_ISSUER="Torii Nihongo"  # Displayed in authenticator apps
TWO_FACTOR_TEMP_TOKEN_EXPIRY=300   # Temporary token expiry (seconds) - 5 minutes

# ========================================
# Google OAuth
# ========================================

# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ========================================
# AI / LLM Configuration
# ========================================
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLIENT_SECRET=your-google-client-secret
