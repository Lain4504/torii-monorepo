# ========================================
# Monorepo Environment Variables
# ========================================
# Tất cả services trong apps/server sẽ load từ file này

# ========================================
# Database (PostgreSQL/Supabase)
# ========================================
# Required - Connection string cho Prisma
DATABASE_URL="postgresql://postgres:123456789@localhost:5432/wajlc"

# ========================================
# Supabase
# ========================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"

# ========================================
# LiveKit Configuration (Local Docker)
# ========================================
# API credentials từ livekit.yaml line 41
LIVEKIT_API_KEY="APIiYAA5w37Cfo2"
LIVEKIT_API_SECRET="6aNur7qqupeZhFYNOJVUyeXxXhVw8f4lm13pEDUx8SgB"

# Server SDK - HTTP REST API (cho NestJS gọi LiveKit API)
LIVEKIT_API_URL="http://localhost:7880"

# Client Browser - WebSocket (cho browser connect real-time media)
LIVEKIT_WS_URL="ws://localhost:7880"

# ========================================
# Redis Configuration
# ========================================
# Required - Redis cho polls, caching, microservices
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ========================================
# NATS Configuration
# ========================================
# Required - NATS JetStream cho messaging, KV storage, analytics
# NATS server
NATS_URL="nats://localhost:4222"
NATS_WS_URLS="ws://localhost:8222"

