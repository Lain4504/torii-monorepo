# ========================================
# Server Configuration
# ========================================
# Gateway server port
PORT=8080

# Environment: development | production | staging
NODE_ENV="development"

# ========================================
# CORS & Security
# ========================================
# Frontend URL for CORS
CORS_ORIGIN="http://localhost:5173"

# ========================================
# File Upload (Optional)
# ========================================
# Directory for file uploads
UPLOAD_DIR="./uploads"

# ========================================
# Analytics (Optional)
# ========================================
# Enable/disable analytics
# ENABLE_ANALYTICS="true"

# ========================================
# Cloudflare R2 Storage (Required for storage-service)
# ========================================
# R2 credentials from Cloudflare dashboard
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
# Bucket name WITHOUT leading slash
R2_BUCKET_NAME="your-bucket-name"
# Account ID (extract from endpoint URL)
R2_ACCOUNT_ID="your-account-id"
# Optional - will be auto-constructed if not provided
R2_PUBLIC_URL="https://your-bucket-name.your-account-id.r2.cloudflarestorage.com"


# ========================================
# wajlc API Security
# ========================================
# Key/secret tự chọn dùng để login vào meet
WAJLC_API_KEY="wajlc"
WAJLC_API_SECRET="zumyyYWqv7KR2kUqvYdq4z4sXg7XTBD2ljT6"

