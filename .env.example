# ========================================
# Monorepo Environment Variables
# ========================================
# Tất cả services trong apps/server sẽ load từ file này

# ========================================
# Database (PostgreSQL/Supabase)
# ========================================
# Required - Connection string cho Prisma
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# ========================================
# Supabase (Optional - nếu dùng Supabase)
# ========================================
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_KEY="your-anon-key"

# ========================================
# LiveKit Configuration
# ========================================
# Required - LiveKit server credentials
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_API_URL="http://localhost:7880"

# ========================================
# Redis Configuration  
# ========================================
# Required - Redis cho polls, caching, microservices
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ========================================
# NATS Configuration
# ========================================
# Required - NATS JetStream cho messaging, KV storage, analytics
NATS_URL="nats://localhost:4222"

# ========================================
# JWT & Authentication
# ========================================
# Required - For auth-service
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ========================================
# Server Configuration
# ========================================
# Gateway server port
PORT=8080

# Environment: development | production | staging
NODE_ENV="development"

# ========================================
# CORS & Security
# ========================================
# Frontend URL for CORS
CORS_ORIGIN="http://localhost:5173"

# ========================================
# File Upload (Optional)
# ========================================
# Directory for file uploads
UPLOAD_DIR="./uploads"

# ========================================
# Analytics (Optional)
# ========================================
# Enable/disable analytics
# ENABLE_ANALYTICS="true"

# ========================================
# AWS S3 (Optional - for cloud storage)
# ========================================
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-bucket-name"
