# ========================================
# Monorepo Environment Variables
# ========================================
# Tất cả services trong apps/server sẽ load từ file này
# Api endpoint for Admin Vite
VITE_API_URL="http://localhost:8080"
# ========================================
# Database (PostgreSQL/Supabase)
# ========================================
# Required - Connection string cho Prisma
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# ========================================
# Supabase
# ========================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"

# ========================================
# LiveKit Configuration
# ========================================
# Required - LiveKit server credentials
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_API_URL="http://localhost:7880"

# ========================================
# Redis Configuration
# ========================================
# Required - Redis cho polls, caching, microservices
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ========================================
# NATS Configuration
# ========================================
# Required - NATS JetStream cho messaging, KV storage, analytics
# NATS server
NATS_URL=nats://localhost:4222

