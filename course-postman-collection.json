    "item": [
        {
            "name": "A. Course CRUD",
            "item": [
                {
                    "name": "TC_COURSE_001: Create VOD Course",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 201', function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "const jsonData = pm.response.json();",
                                    "pm.test('Course created successfully', function () {",
                                    "    pm.expect(jsonData.success).to.eql(true);",
                                    "    pm.expect(jsonData.data.course.status).to.eql('draft');",
                                    "    pm.collectionVariables.set('course_id', jsonData.data.course.id);",
                                    "    pm.collectionVariables.set('course_slug', jsonData.data.course.slug);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Học tiếng Nhật N5 cấp tốc\",\n    \"type\": \"vod\",\n    \"description\": \"Khóa học dành cho người mới bắt đầu\",\n    \"shortDescription\": \"N5 cho người mới\",\n    \"jlptLevel\": \"N5\",\n    \"price\": 299000,\n    \"isFree\": false\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/courses",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "courses"
                            ]
                        }
                    }
                },
